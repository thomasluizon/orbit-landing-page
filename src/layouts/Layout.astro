---
import { Font } from "astro:assets";
import AstraGlyph from "../components/AstraGlyph.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";
import { translations } from "../i18n/translations";
import { offersFor } from "../config/pricing";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  withAstraGlyph?: boolean;
  titleKey?: "meta.title" | "meta.notFound" | "meta.confirmed";
}

const {
  title = translations.en["meta.title"],
  description = translations.en["meta.description"],
  noindex = false,
  withAstraGlyph = false,
  titleKey = "meta.title",
} = Astro.props;

const ogImage = "/og-image.png";
const siteUrl = Astro.site?.origin || "https://useorbit.org";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const googlePlayUrl = "https://play.google.com/store/apps/details?id=org.useorbit.app";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.useorbit.org";
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const renderBuildCommit = process.env.RENDER_GIT_COMMIT;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Orbit",
      url: siteUrl,
      logo: `${siteUrl}/logo.png`,
    },
    {
      "@type": "WebSite",
      name: "Orbit",
      url: siteUrl,
    },
    {
      "@type": "SoftwareApplication",
      name: "Orbit",
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Web",
      offers: offersFor("en"),
      description: description,
    },
    {
      "@type": "MobileApplication",
      name: "Orbit",
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Android",
      offers: offersFor("en"),
      installUrl: googlePlayUrl,
      description: description,
    },
  ],
};
---

<!doctype html>
<html lang="en" style="color-scheme: dark only">
  <head>
    <meta charset="UTF-8" />
    {renderBuildCommit && <meta name="orbit-build" content={renderBuildCommit} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark only" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} data-i18n-content="meta.description" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content="meta.description" />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Orbit" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-content={titleKey} />
    <meta name="twitter:description" content={description} data-i18n-content="meta.description" />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        noindex
          ? {
              "@context": structuredData["@context"],
              "@graph": structuredData["@graph"].slice(0, 2),
            }
          : structuredData,
      )}
    />
    <script>
      import "../scripts/analytics";
      import "../scripts/consent";
    </script>

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-geist-mono" />

    <title data-i18n={titleKey}>{title}</title>
  </head>
  <body class="bg-bg text-fg-1 font-sans antialiased">
    {withAstraGlyph && <AstraGlyph definition />}
    <slot />
    {posthogKey && <ConsentBanner appUrl={appUrl} />}
  </body>
</html>
