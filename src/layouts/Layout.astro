---
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  extraJsonLd?: Record<string, unknown>;
}

const {
  title = "Orbit - The habit tracker you can talk to",
  description = "Orbit pairs a serious habit tracker with Astra, an AI coach that logs your habits and reads your real streaks. Connect Claude or ChatGPT over MCP. Free to start, 7-day Pro trial, no card.",
  noindex = false,
  extraJsonLd,
} = Astro.props;

const ogImage = "/og-image.png";
const siteUrl = Astro.site?.origin || "https://useorbit.org";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const googlePlayUrl = "https://play.google.com/store/apps/details?id=org.useorbit.app";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.useorbit.org";
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Orbit",
      url: siteUrl,
      logo: `${siteUrl}/logo.png`,
    },
    {
      "@type": "WebSite",
      name: "Orbit",
      url: siteUrl,
    },
    {
      "@type": "SoftwareApplication",
      name: "Orbit",
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Web",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      description: description,
    },
    {
      "@type": "MobileApplication",
      name: "Orbit",
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Android",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      installUrl: googlePlayUrl,
      description: description,
    },
  ],
};
---

<!doctype html>
<html lang="en" style="color-scheme: dark only">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark only" />
    <meta name="theme-color" content="#020618" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Orbit" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:site" content="@useorbit" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/logo.png" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      extraJsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
      )
    }
    <script is:inline define:vars={{ posthogKey }}>
      if (posthogKey) {
        let analyticsStarted = false;
        let consentGranted = false;
        let pageSettled = false;

        const startAnalytics = () => {
          if (analyticsStarted || !consentGranted || !pageSettled) return;
          analyticsStarted = true;

          function installPostHogStub(document, posthog) {
            let methodIndex;
            let script;
            let firstScript;
            let instance;
            if (posthog.__SV) return;
            window.posthog = posthog;
            posthog._i = [];
            posthog.init = function (token, config, name) {
              function stub(target, method) {
                const parts = method.split(".");
                if (parts.length === 2) {
                  target = target[parts[0]];
                  method = parts[1];
                }
                target[method] = function (...args) {
                  target.push([method].concat(args));
                };
              }
              script = document.createElement("script");
              script.type = "text/javascript";
              script.crossOrigin = "anonymous";
              script.async = true;
              script.src = `${config.api_host}/static/array.js`;
              firstScript = document.getElementsByTagName("script")[0];
              firstScript.parentNode.insertBefore(script, firstScript);
              instance = posthog;
              if (name !== undefined) {
                instance = posthog[name] = [];
              } else {
                name = "posthog";
              }
              instance.people = instance.people || [];
              instance.toString = function (detail) {
                let value = "posthog";
                if (name !== "posthog") value += `.${name}`;
                if (!detail) value += " (stub)";
                return value;
              };
              instance.people.toString = function () {
                return `${instance.toString(1)}.people (stub)`;
              };
              const methods =
                "init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(
                  " ",
                );
              for (methodIndex = 0; methodIndex < methods.length; methodIndex++) {
                stub(instance, methods[methodIndex]);
              }
              posthog._i.push([token, config, name]);
            };
            posthog.__SV = 1;
          }

          installPostHogStub(document, window.posthog || []);

          window.posthog.init(posthogKey, {
            api_host: `${location.origin}/relay`,
            ui_host: "https://us.posthog.com",
            persistence: "localStorage+cookie",
            cross_subdomain_cookie: true,
            autocapture: false,
            capture_pageview: true,
            capture_pageleave: true,
            disable_session_recording: true,
            loaded: (posthog) => {
              window.dispatchEvent(new CustomEvent("orbit:analytics-ready", { detail: posthog }));
            },
          });
        };

        window.addEventListener("orbit:analytics-consent-granted", () => {
          consentGranted = true;
          startAnalytics();
        });

        window.addEventListener(
          "load",
          () => {
            const markPageSettled = () => {
              pageSettled = true;
              startAnalytics();
            };
            if ("requestIdleCallback" in window) {
              window.requestIdleCallback(markPageSettled, { timeout: 2000 });
            } else {
              window.setTimeout(markPageSettled, 0);
            }
          },
          { once: true },
        );
      }
    </script>

    <Font cssVariable="--font-rubik" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-roboto" />

    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>

    <title>{title}</title>
  </head>
  <body class="bg-bg text-fg-1 font-sans antialiased">
    <slot />
    {posthogKey && <ConsentBanner appUrl={appUrl} />}
    <Analytics />
  </body>
</html>
