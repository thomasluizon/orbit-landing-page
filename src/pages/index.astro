---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import IosWaitlist from "../components/IosWaitlist.astro";
import { translations } from "../i18n/translations";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.useorbit.org";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=org.useorbit.app";
---

<Layout withAstraGlyph>
  <div class="landing-shell">
    <a href="#main-content" class="skip-to-content" data-i18n="skip">{translations.en.skip}</a>
    <Header googlePlayUrl={googlePlayUrl} />
    <main id="main-content" tabindex="-1">
      <Hero appUrl={appUrl} googlePlayUrl={googlePlayUrl} />
    </main>
    <Footer appUrl={appUrl} />
  </div>
  <IosWaitlist />
</Layout>

<script>
  import "../scripts/i18n";
  import "../scripts/waitlist";
  import "../scripts/waitlist-dialog";
</script>
