---
import { ArrowUp } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import FeatureRows from "../components/FeatureRows.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Hero from "../components/Hero.astro";
import IosWaitlist from "../components/IosWaitlist.astro";
import { translations } from "../i18n/translations";
import { appUrl, googlePlayUrl } from "../config/links";
---

<Layout withAstraGlyph>
  <div class="landing-shell">
    <a href="#main-content" class="skip-to-content" data-i18n="skip">{translations.en.skip}</a>
    <Header appUrl={appUrl} />
    <main id="main-content" tabindex="-1">
      <Hero googlePlayUrl={googlePlayUrl} appUrl={appUrl} />
      <FeatureRows />
      <Pricing appUrl={appUrl} />
      <IosWaitlist />
      <Faq />
      <FinalCta appUrl={appUrl} googlePlayUrl={googlePlayUrl} />
    </main>
    <button
      type="button"
      id="back-to-top"
      class="back-to-top"
      hidden
      aria-label={translations.en["back.top"]}
      data-i18n-label="back.top"><ArrowUp size={20} /></button
    >
  </div>
</Layout>

<script>
  import "../scripts/i18n";
  import "../scripts/pricing";
  import "../scripts/faq";
  import "../scripts/back-to-top";
  import "../scripts/scroll";
  import "../scripts/waitlist";
  import "../scripts/waitlist-section";

  const phone = document.querySelector(".hero-device");
  const previewObserver = new IntersectionObserver(
    (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      previewObserver.disconnect();
      void Promise.all([import("../scripts/demo"), import("../scripts/product-examples")]);
    },
    { rootMargin: "160px" },
  );
  if (phone) previewObserver.observe(phone);
</script>
