---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import TrustStrip from "../components/TrustStrip.astro";
import FeatureRows from "../components/FeatureRows.astro";
import Security from "../components/Security.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Features from "../components/Features.astro";
import Hero from "../components/Hero.astro";
import IosWaitlist from "../components/IosWaitlist.astro";
import { translations } from "../i18n/translations";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.useorbit.org";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=org.useorbit.app";
---

<Layout withAstraGlyph>
  <div class="landing-shell">
    <a href="#main-content" class="skip-to-content" data-i18n="skip">{translations.en.skip}</a>
    <Header appUrl={appUrl} />
    <main id="main-content" tabindex="-1">
      <Hero googlePlayUrl={googlePlayUrl} appUrl={appUrl} />
      <TrustStrip />
      <Features appUrl={appUrl} />
      <FeatureRows appUrl={appUrl} />
      <Security />
      <Pricing appUrl={appUrl} />
      <Faq />
      <FinalCta appUrl={appUrl} />
    </main>
    <Footer appUrl={appUrl} googlePlayUrl={googlePlayUrl} />
  </div>
  <IosWaitlist />
</Layout>

<script>
  import "../scripts/i18n";
  import "../scripts/pricing";
  import "../scripts/scroll";
  import "../scripts/waitlist";
  import "../scripts/waitlist-dialog";
</script>
