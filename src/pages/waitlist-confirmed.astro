---
import Layout from "../layouts/Layout.astro";
import CookiePreferences from "../components/CookiePreferences.astro";
import PillButton from "../components/PillButton.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import OrbitMascot from "../components/OrbitMascot.astro";
import Copy from "../components/Copy.astro";
import { translations } from "../i18n/translations";
import { appStoreUrl, appUrl } from "../config/links";
const en = translations.en;
---

<Layout title={en["meta.confirmed"]} titleKey="meta.confirmed" noindex withOrbitMascot>
  <main class="simple-page page-container">
    <div class="simple-page-tools">
      <a href="/" class="brand" translate="no"
        ><img src="/logo.png" alt="" width="48" height="48" /><span>Orbit</span></a
      ><LanguageToggle />
    </div>
    <div id="confirmed-ok">
      <OrbitMascot size={96} state="feliz" class="page-orbit" />
      <h1 class="t-display" data-i18n="waitlistConfirmed.ok.title">
        {en["waitlistConfirmed.ok.title"]}
      </h1>{
        appStoreUrl ? (
          <p class="t-body text-fg-2">
            <Copy name="waitlistConfirmed.ok.bodyStore" />
          </p>
        ) : (
          <p class="t-body text-fg-2" data-i18n="waitlistConfirmed.ok.body">
            {en["waitlistConfirmed.ok.body"]}
          </p>
        )
      }
      <PillButton href={appUrl} appEntry
        ><span data-i18n="waitlistConfirmed.cta">{en["waitlistConfirmed.cta"]}</span></PillButton
      >
    </div>
    <div id="confirmed-invalid" hidden>
      <OrbitMascot size={96} class="page-orbit" />
      <h1 class="t-display" data-i18n="waitlistConfirmed.invalid.title">
        {en["waitlistConfirmed.invalid.title"]}
      </h1>{
        appStoreUrl ? (
          <p class="t-body text-fg-2">
            <Copy name="waitlistConfirmed.invalid.bodyStore" />
          </p>
        ) : (
          <p class="t-body text-fg-2" data-i18n="waitlistConfirmed.invalid.body">
            {en["waitlistConfirmed.invalid.body"]}
          </p>
        )
      }
      <PillButton href={appStoreUrl ? "/#downloads" : "/#ios"}
        >{
          appStoreUrl ? (
            <Copy name="waitlistConfirmed.retryStore" />
          ) : (
            <span data-i18n="waitlistConfirmed.retry">{en["waitlistConfirmed.retry"]}</span>
          )
        }</PillButton
      >
    </div>
    <footer><CookiePreferences /></footer>
  </main>
</Layout>
<script>
  if (new URLSearchParams(window.location.search).get("status") === "invalid") {
    const ok = document.getElementById("confirmed-ok");
    const invalid = document.getElementById("confirmed-invalid");
    if (ok) ok.hidden = true;
    if (invalid) invalid.hidden = false;
  }
</script>
<script>
  import "../scripts/i18n";
</script>
