---
import Layout from "../layouts/Layout.astro";
import PillButton from "../components/PillButton.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import { translations } from "../i18n/translations";
import { appUrl } from "../config/links";
const en = translations.en;
---

<Layout title={en["meta.confirmed"]} titleKey="meta.confirmed" noindex>
  <main class="simple-page page-container">
    <div class="simple-page-tools">
      <a href="/" class="brand" translate="no"
        ><img src="/logo.png" alt="" width="48" height="48" /><span>Orbit</span></a
      ><LanguageToggle />
    </div>
    <div id="confirmed-ok">
      <h1 class="t-display" data-i18n="waitlistConfirmed.ok.title">
        {en["waitlistConfirmed.ok.title"]}
      </h1><p class="t-body text-fg-2" data-i18n="waitlistConfirmed.ok.body">
        {en["waitlistConfirmed.ok.body"]}
      </p>
      <PillButton href={appUrl} appEntry
        ><span data-i18n="waitlistConfirmed.cta">{en["waitlistConfirmed.cta"]}</span></PillButton
      >
    </div>
    <div id="confirmed-invalid" hidden>
      <h1 class="t-display" data-i18n="waitlistConfirmed.invalid.title">
        {en["waitlistConfirmed.invalid.title"]}
      </h1><p class="t-body text-fg-2" data-i18n="waitlistConfirmed.invalid.body">
        {en["waitlistConfirmed.invalid.body"]}
      </p>
      <PillButton href="/#ios"
        ><span data-i18n="waitlistConfirmed.retry">{en["waitlistConfirmed.retry"]}</span
        ></PillButton
      >
    </div>
  </main>
</Layout>
<script is:inline>
  if (new URLSearchParams(window.location.search).get("status") === "invalid") {
    const ok = document.getElementById("confirmed-ok");
    const invalid = document.getElementById("confirmed-invalid");
    if (ok) ok.hidden = true;
    if (invalid) invalid.hidden = false;
  }
</script>
<script>
  import "../scripts/i18n";
</script>
