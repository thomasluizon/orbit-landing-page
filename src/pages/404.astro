---
import Layout from "../layouts/Layout.astro";
import CookiePreferences from "../components/CookiePreferences.astro";
import PillButton from "../components/PillButton.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import { translations } from "../i18n/translations";
const en = translations.en;
---

<Layout title={en["meta.notFound"]} titleKey="meta.notFound" noindex>
  <main class="simple-page page-container">
    <div class="simple-page-tools">
      <a href="/" class="brand" translate="no"
        ><img src="/logo.png" alt="" width="48" height="48" /><span>Orbit</span></a
      ><LanguageToggle />
    </div>
    <p class="t-meta">404</p>
    <h1 class="t-display" data-i18n="notFound.title">{en["notFound.title"]}</h1>
    <p class="t-body text-fg-2" data-i18n="notFound.body">{en["notFound.body"]}</p>
    <PillButton href="/"><span data-i18n="notFound.cta">{en["notFound.cta"]}</span></PillButton>
    <footer><CookiePreferences /></footer>
  </main>
</Layout>
<script>
  import "../scripts/i18n";
</script>
