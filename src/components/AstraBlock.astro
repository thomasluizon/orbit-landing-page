---
import Copy from "./Copy.astro";
import {
  exampleWeek,
  exampleDays,
  exampleGoal,
  exampleBreakdown,
  buildNow,
} from "../config/product-examples";
import { landingCopy, translations, type Language } from "../i18n/translations";
import { clockText } from "../scripts/clock-format";
import { clockLabel } from "../scripts/demo-dates";
interface Props {
  kind: "metrics" | "breakdown" | "goal";
  interactive?: boolean;
}
const { kind, interactive = false } = Astro.props;
const offsets = exampleWeek.map((_, index) => index - (exampleWeek.length - 1));
const dates = offsets.map((offset) => clockText("chart", buildNow, offset));
const completion = Math.round(
  exampleWeek.reduce((sum, value) => sum + value, 0) / exampleWeek.length,
);
function doneLabel(language: Language, index: number) {
  const { done, total } = exampleDays[index];
  return landingCopy[language]["blocks.metrics.done"]
    .replace("{done}", String(done))
    .replace("{total}", String(total));
}
function barTemplate(language: Language, index: number) {
  return `{date}, ${exampleWeek[index]}%, ${doneLabel(language, index)}`;
}
function barLabel(index: number) {
  return clockLabel(
    { en: barTemplate("en", index), "pt-BR": barTemplate("pt-BR", index) },
    buildNow,
    offsets[index],
  );
}
---

<div class="astra-product" data-mock="true">
  <div
    class:list={["product-block", `block-${kind}`]}
    data-example-block={interactive ? kind : undefined}
    data-composition-card
    data-product-kind={kind}
  >
    {
      kind === "metrics" && (
        <>
          <h3>
            <Copy name="blocks.metrics.title" />
          </h3>
          <div class="metric-chart" data-metric-chart>
            <div class="metric-readout-row">
              <div
                class="metric-readout"
                aria-live={interactive ? "polite" : undefined}
                aria-atomic={interactive ? "true" : undefined}
              >
                {exampleWeek.map((value, index) => (
                  <span data-metric-readout={index} hidden={index !== exampleWeek.length - 1}>
                    <span
                      data-clock="chart"
                      data-clock-offset={offsets[index]}
                      data-copy-en={dates[index].en}
                      data-copy-pt={dates[index]["pt-BR"]}
                    >
                      {dates[index].en}
                    </span>
                    <strong>{value}%</strong>
                    <span
                      data-copy-en={doneLabel("en", index)}
                      data-copy-pt={doneLabel("pt-BR", index)}
                    >
                      {doneLabel("en", index)}
                    </span>
                  </span>
                ))}
              </div>
            </div>
            <div
              class="metric-bars"
              role={interactive ? "radiogroup" : undefined}
              aria-label={interactive ? landingCopy.en["blocks.metrics.choose"] : undefined}
              data-copy-label-en={interactive ? landingCopy.en["blocks.metrics.choose"] : undefined}
              data-copy-label-pt={
                interactive ? landingCopy["pt-BR"]["blocks.metrics.choose"] : undefined
              }
              aria-hidden={!interactive || undefined}
            >
              {exampleWeek.map((value, index) =>
                interactive ? (
                  <button
                    type="button"
                    class="metric-bar-track"
                    role="radio"
                    data-metric-day={index}
                    aria-checked={index === exampleWeek.length - 1}
                    tabindex={index === exampleWeek.length - 1 ? 0 : -1}
                    aria-label={barLabel(index).en}
                    data-copy-label-en={barLabel(index).en}
                    data-copy-label-pt={barLabel(index)["pt-BR"]}
                    data-clock-offset={offsets[index]}
                    data-clock-label-en={barTemplate("en", index)}
                    data-clock-label-pt={barTemplate("pt-BR", index)}
                  >
                    <span
                      class="metric-bar"
                      data-selected={String(index === exampleWeek.length - 1)}
                      style={`--bar-height: ${value}%`}
                    />
                  </button>
                ) : (
                  <span class="metric-bar-track">
                    <span
                      class="metric-bar"
                      data-selected={String(index === exampleWeek.length - 1)}
                      style={`--bar-height: ${value}%`}
                    />
                  </span>
                ),
              )}
            </div>
            <div class="metric-dates product-caption">
              <>
                {[0, exampleWeek.length - 1].map((index) => (
                  <span
                    data-clock="chart"
                    data-clock-offset={offsets[index]}
                    data-copy-en={dates[index].en}
                    data-copy-pt={dates[index]["pt-BR"]}
                  >
                    {dates[index].en}
                  </span>
                ))}
              </>
            </div>
          </div>
          <dl class="metric-figures" data-composition-secondary>
            <div>
              <>
                <dt>
                  <Copy name="blocks.metrics.completion" />
                </dt>
                <dd>{completion}%</dd>
              </>
            </div>
            <div>
              <>
                <dt>
                  <Copy name="blocks.metrics.active" />
                </dt>
                <dd>
                  <Copy name="blocks.metrics.days" />
                </dd>
              </>
            </div>
          </dl>
        </>
      )
    }
    {
      kind === "breakdown" && (
        <>
          <h3>
            <Copy name="blocks.breakdown.title" />
          </h3>
          <p class="demo-request">
            <Copy name="blocks.breakdown.request" />
          </p>
          <div class="breakdown-proposal">
            <p class="product-caption" data-i18n="demo.proposed">
              {translations.en["demo.proposed"]}
            </p>
            <div class="breakdown-list">
              {exampleBreakdown.map(({ habit, cadence }, index) => (
                <div
                  class="breakdown-row"
                  data-composition-secondary={index === exampleBreakdown.length - 1 || undefined}
                >
                  <span class="habit-name">
                    <Copy name={`blocks.breakdown.${habit}`} />
                  </span>
                  <span class="product-caption">
                    <Copy name={`blocks.breakdown.${cadence}`} />
                  </span>
                </div>
              ))}
            </div>
          </div>
        </>
      )
    }
    {
      kind === "goal" && (
        <>
          <h3 class="goal-title">
            <Copy name="blocks.goal.title" />
          </h3>
          <p class="goal-figure">
            <Copy name="blocks.goal.progress" />
          </p>
          <div
            class="goal-progress"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax={exampleGoal.target}
            aria-valuenow={exampleGoal.progress}
            aria-label={landingCopy.en["blocks.goal.title"]}
            data-copy-label-en={landingCopy.en["blocks.goal.title"]}
            data-copy-label-pt={landingCopy["pt-BR"]["blocks.goal.title"]}
          >
            <span
              class="goal-progress-fill"
              style={`--goal-progress: ${(exampleGoal.progress / exampleGoal.target) * 100}%`}
            />
          </div>
          <p
            class="product-caption"
            data-copy-en={landingCopy.en["blocks.goal.linked"].replace(
              "{count}",
              String(exampleGoal.linkedHabitCount),
            )}
            data-copy-pt={landingCopy["pt-BR"]["blocks.goal.linked"].replace(
              "{count}",
              String(exampleGoal.linkedHabitCount),
            )}
          >
            {landingCopy.en["blocks.goal.linked"].replace(
              "{count}",
              String(exampleGoal.linkedHabitCount),
            )}
          </p>
        </>
      )
    }
  </div>
</div>
