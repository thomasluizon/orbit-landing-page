---
import AstraGlyph from "./AstraGlyph.astro";
import Copy from "./Copy.astro";
import HabitRow from "./HabitRow.astro";
import PillButton from "./PillButton.astro";
import { exampleWeek, exampleGoal, exampleBreakdown } from "../config/product-examples";
import { landingCopy, translations, type LandingKey } from "../i18n/translations";
interface Props {
  kind: "metrics" | "habits" | "breakdown" | "goal";
  interactive?: boolean;
  embedded?: boolean;
}
const { kind, interactive = false, embedded = false } = Astro.props;
const dateKeys = exampleWeek.map((_, index) => `blocks.metrics.date${index}` as LandingKey);
const completion = Math.round(
  exampleWeek.reduce((sum, value) => sum + value, 0) / exampleWeek.length,
);
---

<div class="astra-product" data-mock="true">
  {
    kind !== "goal" && (
      <div class="vignette-astra">
        <AstraGlyph size={16} />
        <p>
          <Copy
            name={
              kind === "metrics"
                ? "product.progressReply"
                : kind === "breakdown"
                  ? "blocks.breakdown.reply"
                  : "product.proactive"
            }
          />
        </p>
      </div>
    )
  }
  <div
    class:list={["product-block", `block-${kind}`]}
    data-example-block={interactive ? kind : undefined}
    data-embedded={embedded || undefined}
    data-state={kind === "breakdown" ? "proposed" : undefined}
  >
    {
      kind === "metrics" && (
        <>
          <h3>
            <Copy name="blocks.metrics.title" />
          </h3>
          <div class="metric-chart">
            <div
              class="metric-readout"
              aria-live={interactive ? "polite" : undefined}
              aria-atomic={interactive ? "true" : undefined}
            >
              {exampleWeek.map((value, index) => (
                <span data-metric-readout={index} hidden={index !== exampleWeek.length - 1}>
                  <Copy name={dateKeys[index]} />
                  <strong>{value}%</strong>
                </span>
              ))}
            </div>
            <div class="metric-bars" aria-hidden="true">
              {exampleWeek.map((value, index) => (
                <span class="metric-bar-track">
                  <span
                    class="metric-bar"
                    data-metric-bar={index}
                    data-selected={String(index === 6)}
                    style={`--bar-height: ${value}%`}
                  />
                </span>
              ))}
            </div>
            {interactive && (
              <input
                type="range"
                min="0"
                max={exampleWeek.length - 1}
                value={exampleWeek.length - 1}
                step="1"
                data-metric-day
                aria-label={landingCopy.en["blocks.metrics.choose"]}
                data-copy-label-en={landingCopy.en["blocks.metrics.choose"]}
                data-copy-label-pt={landingCopy["pt-BR"]["blocks.metrics.choose"]}
              />
            )}
            <div class="metric-dates product-caption">
              <>
                <Copy name="blocks.metrics.date0" />
                <Copy name="blocks.metrics.date6" />
              </>
            </div>
          </div>
          <dl class="metric-figures">
            <div>
              <>
                <dt>
                  <Copy name="blocks.metrics.completion" />
                </dt>
                <dd>{completion}%</dd>
              </>
            </div>
            <div>
              <>
                <dt>
                  <Copy name="blocks.metrics.active" />
                </dt>
                <dd>
                  <Copy name="blocks.metrics.days" />
                </dd>
              </>
            </div>
          </dl>
        </>
      )
    }
    {
      kind === "habits" && (
        <>
          <h3>
            <Copy name="blocks.habits.title" />
          </h3>
          <div class="block-habit-list">
            <HabitRow habit="walk" timing="morning" interactive={interactive} />
            <HabitRow habit="read" interactive={interactive} />
          </div>
          {interactive && (
            <p class="product-caption" role="status" aria-live="polite" data-example-count />
          )}
        </>
      )
    }
    {
      kind === "breakdown" && (
        <>
          <h3>
            <Copy name="blocks.breakdown.title" />
          </h3>
          <div class="breakdown-proposal" data-breakdown-proposal>
            <p class="product-caption" data-i18n="demo.proposed">
              {translations.en["demo.proposed"]}
            </p>
            <div class="breakdown-list">
              {exampleBreakdown.map(({ habit, cadence }) => (
                <div
                  class="breakdown-row"
                  data-frequency
                  data-cadence={cadence}
                  data-initial-cadence={cadence}
                  role={interactive ? "group" : undefined}
                  aria-label={interactive ? landingCopy.en[`blocks.breakdown.${habit}`] : undefined}
                  data-copy-label-en={
                    interactive ? landingCopy.en[`blocks.breakdown.${habit}`] : undefined
                  }
                  data-copy-label-pt={
                    interactive ? landingCopy["pt-BR"][`blocks.breakdown.${habit}`] : undefined
                  }
                >
                  <span class="habit-name">
                    <Copy name={`blocks.breakdown.${habit}`} />
                  </span>
                  {interactive ? (
                    <PillButton variant="ghost" size="sm" class="frequency-control">
                      <Copy name={`blocks.breakdown.${cadence}`} />
                    </PillButton>
                  ) : (
                    <span class="product-caption">
                      <Copy name={`blocks.breakdown.${cadence}`} />
                    </span>
                  )}
                </div>
              ))}
            </div>
            {interactive && (
              <div class="block-actions">
                <PillButton variant="ghost" size="sm" class="breakdown-reject">
                  <span data-i18n="demo.reject">{translations.en["demo.reject"]}</span>
                </PillButton>
                <PillButton variant="ghost" size="sm" class="breakdown-edit">
                  <span data-i18n="demo.edit">{translations.en["demo.edit"]}</span>
                </PillButton>
                <PillButton size="sm" class="breakdown-approve">
                  <span data-i18n="demo.approve">{translations.en["demo.approve"]}</span>
                </PillButton>
              </div>
            )}
          </div>
          {interactive && (
            <>
              <p
                class="product-caption"
                role="status"
                aria-live="polite"
                aria-atomic="true"
                data-breakdown-status
              />
              <div class="block-habit-list" data-breakdown-result hidden>
                {exampleBreakdown.map(({ habit, cadence }, index) => (
                  <div class="breakdown-row">
                    <div>
                      <p class="habit-name">
                        <Copy name={`blocks.breakdown.${habit}`} />
                      </p>
                      <p class="product-caption" data-result-frequency={index}>
                        <Copy name={`blocks.breakdown.${cadence}`} />
                      </p>
                    </div>
                    <span class="status-ring" aria-hidden="true" />
                  </div>
                ))}
              </div>
              <PillButton variant="ghost" size="sm" class="breakdown-reset">
                <Copy name="blocks.reset" />
              </PillButton>
            </>
          )}
        </>
      )
    }
    {
      kind === "goal" && (
        <>
          <h3 class="goal-title">
            <Copy name="blocks.goal.title" />
          </h3>
          <p class="goal-figure">
            <Copy name="blocks.goal.progress" />
          </p>
          <div
            class="goal-progress"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax={exampleGoal.target}
            aria-valuenow={exampleGoal.progress}
            aria-label={landingCopy.en["blocks.goal.title"]}
            data-copy-label-en={landingCopy.en["blocks.goal.title"]}
            data-copy-label-pt={landingCopy["pt-BR"]["blocks.goal.title"]}
          >
            <span
              class="goal-progress-fill"
              style={`--goal-progress: ${(exampleGoal.progress / exampleGoal.target) * 100}%`}
            />
          </div>
          <p class="product-caption">
            <Copy name="blocks.goal.derived" />
          </p>
          <div class="goal-habits">
            <h4 class="product-caption">
              <Copy name="blocks.goal.linked" />
            </h4>
            {exampleGoal.habits.map(({ habit, emoji, streak }) => (
              <div class="goal-habit">
                <span aria-hidden="true">{emoji}</span>
                <p class="habit-name">
                  <Copy name={`product.${habit}`} />
                </p>
                <span
                  class="product-caption"
                  data-copy-en={landingCopy.en["blocks.goal.days"].replace(
                    "{days}",
                    String(streak),
                  )}
                  data-copy-pt={landingCopy["pt-BR"]["blocks.goal.days"].replace(
                    "{days}",
                    String(streak),
                  )}
                >
                  {landingCopy.en["blocks.goal.days"].replace("{days}", String(streak))}
                </span>
              </div>
            ))}
          </div>
        </>
      )
    }
  </div>
</div>

<script>
  import "../scripts/product-examples";
</script>
