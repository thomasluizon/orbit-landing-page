---
import PillButton from "./PillButton.astro";

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
---

<aside
  id="consent-banner"
  class="consent-banner fixed inset-x-0 bottom-4 z-[60] px-4 sm:bottom-5 sm:px-5"
  hidden
>
  <div
    class="mx-auto max-w-[920px] rounded-[18px] bg-bg p-4"
    style="box-shadow: inset 0 1px 0 var(--color-hairline);"
  >
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1">
        <p class="t-secondary" data-i18n="consent.body">
          We use optional analytics cookies to see how this site is used.
        </p>
        <a
          href={`${appUrl}/privacy`}
          class="font-sans text-[14px] text-fg-2 underline underline-offset-2 transition-[color] duration-[var(--duration-fast)] ease-standard hover:text-fg-1"
          data-i18n="consent.privacy"
        >
          Privacy Policy
        </a>
      </div>
      <div class="flex shrink-0 gap-3">
        <PillButton id="consent-decline" variant="ghost" size="sm" class="flex-1 sm:flex-none">
          <span data-i18n="consent.decline">Decline</span>
        </PillButton>
        <PillButton id="consent-accept" size="sm" class="flex-1 sm:flex-none">
          <span data-i18n="consent.accept">Allow</span>
        </PillButton>
      </div>
    </div>
  </div>
</aside>

<script>
  import "../scripts/consent";
</script>
