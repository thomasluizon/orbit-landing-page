---
import {
  Check,
  ChevronLeft,
  ChevronRight,
  Plus,
  ArrowUp,
  CalendarDays,
  House,
  LayoutDashboard,
  User,
  Bell,
  Search,
  EllipsisVertical,
} from "@lucide/astro";
import AstraGlyph from "./AstraGlyph.astro";
import { translations } from "../i18n/translations";
const en = translations.en;
const habits = [
  { emoji: "💧", key: "mockup.habit1", done: true },
  { emoji: "🚶", key: "mockup.habit2", done: false },
  { emoji: "📖", key: "mockup.habit3", done: false },
] as const;
const tabs = [
  { icon: House, key: "mockup.today" },
  { icon: CalendarDays, key: "mockup.calendar" },
  { icon: LayoutDashboard, key: "mockup.progress" },
  { icon: User, key: "mockup.profile" },
] as const;
---

<figure class="product-figure">
  <div class="phone" data-screen="today" data-mock="true" aria-hidden="true">
    <div class="phone-tools">
      <Search size={20} /><EllipsisVertical size={20} /><Bell size={20} />
    </div>
    <div class="phone-notice">
      <AstraGlyph /><p data-i18n="mockup.notice">{en["mockup.notice"]}</p>
    </div>
    <div class="phone-date">
      <ChevronLeft size={20} /><p class="t-h2" data-i18n="mockup.today">
        {en["mockup.today"]}
      </p><ChevronRight size={20} />
    </div>
    <div class="phone-habits">
      {
        habits.map(({ emoji, key, done }) => (
          <div class="habit-row">
            <>
              <span class="habit-emoji">{emoji}</span>
              <div>
                <>
                  <p data-i18n={key}>{en[key]}</p>
                  <p class="t-meta" data-i18n={done ? "mockup.done" : "mockup.time"}>
                    {en[done ? "mockup.done" : "mockup.time"]}
                  </p>
                </>
              </div>
              <span class:list={["status-ring", { "is-done": done }]}>
                {done && <Check size={16} />}
              </span>
            </>
          </div>
        ))
      }
    </div>
    <div class="phone-create"><span><Plus size={24} /></span></div>
    <div class="phone-composer">
      <AstraGlyph /><span data-i18n="mockup.composer">{en["mockup.composer"]}</span><Plus
        size={20}
      /><ArrowUp size={20} />
    </div>
    <div class="phone-tabs">
      {
        tabs.map(({ icon: Icon, key }, index) => (
          <div class:list={{ "is-current": index === 0 }}>
            <>
              <Icon size={20} />
              <span data-i18n={key}>{en[key]}</span>
            </>
          </div>
        ))
      }
    </div>
  </div>
  <figcaption class="t-meta" data-i18n="mockup.caption">{en["mockup.caption"]}</figcaption>
</figure>
