---
type PillVariant = "primary" | "ghost";
type PillSize = "md" | "sm";

interface Props {
  href?: string;
  type?: "button" | "submit";
  disabled?: boolean;
  variant?: PillVariant;
  size?: PillSize;
  external?: boolean;
  class?: string;
  ariaLabel?: string;
  id?: string;
  analyticsEvent?: string;
  analyticsSurface?: string;
}

const {
  href,
  type = "button",
  disabled = false,
  variant = "primary",
  size = "sm",
  external = false,
  class: className = "",
  ariaLabel,
  id,
  analyticsEvent,
  analyticsSurface,
} = Astro.props;

const variantClasses: Record<PillVariant, string> = {
  primary:
    "bg-primary text-fg-on-primary hover:bg-primary-hover active:bg-primary-pressed active:scale-[0.96]",
  ghost:
    "bg-transparent text-fg-1 shadow-[inset_0_0_0_1.5px_var(--color-hairline-strong)] hover:bg-bg-hover active:scale-[0.96]",
};

const sizeClasses: Record<PillSize, string> = {
  md: "min-h-[50px] px-[26px] text-[16px] gap-[9px]",
  sm: "pill-sm min-h-[40px] px-[18px] text-[14px] gap-[7px]",
};
---

{
  href ? (
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      aria-label={ariaLabel}
      id={id}
      data-analytics-event={analyticsEvent}
      data-analytics-surface={analyticsSurface}
      class:list={[
        "control-transition relative inline-flex cursor-pointer items-center justify-center rounded-full font-sans font-medium disabled:cursor-not-allowed disabled:opacity-70",
        variantClasses[variant],
        sizeClasses[size],
        className,
      ]}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
      id={id}
      data-analytics-event={analyticsEvent}
      data-analytics-surface={analyticsSurface}
      class:list={[
        "control-transition relative inline-flex cursor-pointer items-center justify-center rounded-full font-sans font-medium disabled:cursor-not-allowed disabled:opacity-70",
        variantClasses[variant],
        sizeClasses[size],
        className,
      ]}
    >
      <slot />
    </button>
  )
}
