---
import githubIcon from "../assets/github.svg?raw";
import Copy from "./Copy.astro";
import { translations } from "../i18n/translations";
import orbitLockup from "../../public/brand/orbit-lockup.svg?raw";
import orbitMark from "../../public/brand/orbit-mark-16.svg?raw";
interface Props {
  appUrl: string;
  googlePlayUrl: string;
}
const { appUrl, googlePlayUrl } = Astro.props;
const en = translations.en;
const lockup = orbitLockup
  .replace(/<title\b[^>]*>[\s\S]*?<\/title>/g, "")
  .replace(/\saria-labelledby="[^"]*"/g, "");
---

<footer class="site-footer" data-section="footer">
  <div class="section-inner">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Orbit" translate="no"
          ><span class="brand-lockup" aria-hidden="true" set:html={lockup} /></a
        >
        <p><Copy name="footer.description" /></p>
        <div class="footer-links">
          <a href="https://github.com/thomasluizon/orbit-landing-page" class="text-link"
            ><span class="footer-social-icon" set:html={githubIcon} /><Copy
              name="footer.source"
            /></a
          >
          <a
            href={appUrl}
            class="text-link"
            data-i18n="hero.web"
            data-analytics-event="hero_app_cta_clicked"
            data-analytics-surface="footer">{en["hero.web"]}</a
          >
          <a
            href="#ios"
            id="ios-trigger"
            data-ios-trigger
            class="text-link"
            aria-haspopup="dialog"
            aria-controls="ios"
            data-i18n="hero.ios">{en["hero.ios"]}</a
          >
        </div>
      </div>
      <a class="footer-qr" href={googlePlayUrl}
        ><span class="footer-qr-code">
          <img src="/orbit-install-qr.svg" width="240" height="240" loading="lazy" alt="" />
          <span class="footer-qr-mark" aria-hidden="true" set:html={orbitMark} />
        </span><Copy name="footer.qr" /></a
      >
    </div>
    <div class="footer-bottom">
      <span translate="no">© Orbit</span>
      <div class="footer-links">
        <a href={`${appUrl}/privacy`} class="text-link" data-i18n="footer.privacy"
          >{en["footer.privacy"]}</a
        ><a href={`${appUrl}/terms`} class="text-link" data-i18n="footer.terms"
          >{en["footer.terms"]}</a
        >
      </div>
    </div>
  </div>
</footer>
