---
import PillButton from "./PillButton.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { translations } from "../i18n/translations";
interface Props {
  googlePlayUrl: string;
}
const { googlePlayUrl } = Astro.props;
---

<header id="site-header" class="site-header">
  <nav class="header-content" aria-label={translations.en["nav.label"]} data-i18n-label="nav.label">
    <a href="/" class="brand" aria-label="Orbit" translate="no"
      ><img src="/brand/orbit-lockup.svg" alt="" width="112" height="24" /></a
    >
    <div class="header-actions">
      <LanguageToggle /><PillButton
        href={googlePlayUrl}
        variant="ghost"
        size="sm"
        external
        analyticsEvent="header_app_cta_clicked"
        analyticsSurface="header"
        ><span data-i18n="header.cta">{translations.en["header.cta"]}</span></PillButton
      >
    </div>
  </nav>
</header>
