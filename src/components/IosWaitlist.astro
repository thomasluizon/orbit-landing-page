---
import PillButton from "./PillButton.astro";
import { translations } from "../i18n/translations";
const en = translations.en;
---

<section
  id="ios"
  class="section ios-section"
  data-section="ios"
  aria-labelledby="ios-title"
  aria-describedby="ios-description"
>
  <div class="waitlist-content">
    <div class="section-heading">
      <span class="coming-soon" data-i18n="ios.soon">{en["ios.soon"]}</span>
      <h2 id="ios-title" class="section-title" data-i18n="ios.title">{en["ios.title"]}</h2><p
        id="ios-description"
        class="t-secondary"
        data-i18n="ios.desc"
      >
        {en["ios.desc"]}
      </p>
    </div>
    <div>
      <form id="waitlist-form" novalidate>
        <label for="waitlist-email" class="t-secondary" data-i18n="ios.label"
          >{en["ios.label"]}</label
        >
        <input
          id="waitlist-email"
          type="email"
          name="email"
          autocomplete="email"
          spellcheck="false"
          required
          placeholder={en["ios.placeholder"]}
          data-i18n-placeholder="ios.placeholder"
          aria-describedby="waitlist-status waitlist-privacy"
        />
        <div id="waitlist-turnstile"></div>
        <PillButton id="waitlist-submit" type="submit" disabled size="sm">
          <span id="waitlist-submit-label" data-i18n="ios.button">{en["ios.button"]}</span>
        </PillButton>
      </form>
      <p id="waitlist-status" role="status" aria-live="polite" class="t-secondary"></p>
      <p id="waitlist-privacy" class="t-meta" data-i18n="ios.privacy">{en["ios.privacy"]}</p>
    </div>
  </div>
</section>
