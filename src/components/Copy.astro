---
import { landingCopy, type LandingKey } from "../i18n/translations";
interface Props {
  name: LandingKey;
}
const { name } = Astro.props;
---

<span
  translate={/\b(?:Orbit|Astra)\b/.test(landingCopy.en[name]) ? "no" : undefined}
  data-copy-en={landingCopy.en[name]}
  data-copy-pt={landingCopy["pt-BR"][name]}>{landingCopy.en[name]}</span
>
