---
import SentenceTitle from "./SentenceTitle.astro";
import Copy from "./Copy.astro";
import ProductCard from "./ProductCard.astro";
import PillButton from "./PillButton.astro";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
---

<section class="section" data-section="details" aria-labelledby="remember-title">
  <div class="section-inner">
    <div class="feature-row">
      <div class="feature-copy">
        <h2 id="remember-title" class="section-title"><Copy name="remember.title" /></h2><p
          class="section-description"
        >
          <Copy name="remember.body" />
        </p><PillButton href={appUrl} size="md"><Copy name="action.start" /></PillButton>
      </div>
      <div class="feature-composition">
        <div class="feature-art feature-art-busy">
          <ProductCard kind="today" /><div class="feature-reminder" data-reveal>
            <ProductCard kind="reminder" />
          </div>
        </div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
    </div>
  </div>
</section>
<section class="section" data-section="progress" aria-labelledby="understand-title">
  <div class="section-inner">
    <div class="feature-row">
      <div class="feature-copy">
        <SentenceTitle id="understand-title" name="understand.title" /><p
          class="section-description"
        >
          <Copy name="understand.body" />
        </p><PillButton href={appUrl} size="md"><Copy name="action.start" /></PillButton>
      </div>
      <div class="feature-composition">
        <div class="feature-art">
          <ProductCard kind="week" /><p class="sample-message" data-reveal>
            <Copy name="product.progressRequest" />
          </p>
        </div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
    </div>
  </div>
</section>
<section class="section" data-section="restart" aria-labelledby="restart-title">
  <div class="section-inner">
    <div class="feature-row">
      <div class="feature-copy">
        <SentenceTitle id="restart-title" name="restart.title" /><p class="section-description">
          <Copy name="restart.body" />
        </p><PillButton href={appUrl} size="md"><Copy name="action.start" /></PillButton>
      </div>
      <div class="feature-composition">
        <div class="feature-art"><ProductCard kind="restart" /></div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
    </div>
  </div>
</section>
