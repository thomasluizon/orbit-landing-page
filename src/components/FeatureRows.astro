---
import SentenceTitle from "./SentenceTitle.astro";
import Copy from "./Copy.astro";
import ProductCard from "./ProductCard.astro";
import PillButton from "./PillButton.astro";
import AstraGlyph from "./AstraGlyph.astro";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
---

<section class="section feature-section" data-section="details" aria-labelledby="remember-title">
  <div class="section-inner">
    <div class="feature-row">
      <div class="feature-copy">
        <div class="feature-intro">
          <h2 id="remember-title" class="section-title"><Copy name="remember.title" /></h2><p
            class="section-description"
          >
            <Copy name="remember.body" />
          </p>
        </div><PillButton
          href={appUrl}
          variant="ghost"
          size="md"
          analyticsEvent="hero_app_cta_clicked"
          analyticsSurface="details"><Copy name="action.start" /></PillButton
        >
      </div>
      <div class="feature-composition">
        <div class="feature-art feature-art-busy">
          <div class="feature-stack">
            <div class="feature-primary"><ProductCard kind="today" compact /></div>
            <div class="feature-secondary feature-reminder" data-reveal>
              <ProductCard kind="reminder" />
            </div>
          </div>
        </div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
    </div>
  </div>
</section>
<section class="section feature-section" data-section="progress" aria-labelledby="understand-title">
  <div class="section-inner">
    <div class="feature-row">
      <div class="feature-copy">
        <div class="feature-intro">
          <SentenceTitle id="understand-title" name="understand.title" /><p
            class="section-description"
          >
            <Copy name="understand.body" />
          </p>
        </div><PillButton
          href={appUrl}
          variant="ghost"
          size="md"
          analyticsEvent="hero_app_cta_clicked"
          analyticsSurface="progress"><Copy name="action.start" /></PillButton
        >
      </div>
      <div class="feature-composition">
        <div class="feature-art feature-art-progress">
          <div class="feature-stack">
            <div class="feature-primary">
              <ProductCard kind="week" />
            </div>
            <div class="feature-secondary progress-reply" data-reveal>
              <AstraGlyph /><p><Copy name="product.progressReply" /></p>
            </div>
          </div>
        </div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
    </div>
  </div>
</section>
<section class="section feature-section" data-section="restart" aria-labelledby="restart-title">
  <div class="section-inner">
    <div class="feature-row">
      <div class="feature-copy">
        <div class="feature-intro">
          <SentenceTitle id="restart-title" name="restart.title" /><p class="section-description">
            <Copy name="restart.body" />
          </p>
        </div><PillButton
          href={appUrl}
          variant="ghost"
          size="md"
          analyticsEvent="hero_app_cta_clicked"
          analyticsSurface="restart"><Copy name="action.start" /></PillButton
        >
      </div>
      <div class="feature-composition">
        <div class="feature-art feature-art-restart">
          <div class="feature-stack">
            <div class="feature-primary"><ProductCard kind="restart" /></div>
            <div class="feature-secondary feature-return" data-reveal>
              <ProductCard kind="walk" />
            </div>
          </div>
        </div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
    </div>
  </div>
</section>
