---
import { ArrowUp, Check } from "@lucide/astro";
import Copy from "./Copy.astro";
import AstraGlyph from "./AstraGlyph.astro";
import PillButton from "./PillButton.astro";
import { translations } from "../i18n/translations";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
const en = translations.en;
---

<section id="astra-demo" class="astra-demo" aria-labelledby="demo-title" data-example>
  <div class="demo-heading">
    <AstraGlyph />
    <h2 id="demo-title" class="t-row" translate="no">Astra</h2>
  </div>
  <div class="demo-thread">
    <div class="demo-exchange" aria-live="polite" aria-atomic="true" aria-busy="false">
      <p id="demo-request" class="demo-request t-body" data-i18n="demo.start.request">
        {en["demo.start.request"]}
      </p>
      <div id="demo-response" class="demo-response">
        <p id="demo-reply" class="t-body" data-i18n="demo.start.reply">
          {en["demo.start.reply"]}
        </p>
        <div id="demo-preview" class="demo-preview" data-state="proposed">
          <p class="demo-proposed product-caption" data-i18n="demo.proposed">
            {en["demo.proposed"]}
          </p>
          <div class="demo-habits">
            <div class="demo-habit">
              <p id="demo-habit" class="t-row" data-i18n="demo.start.habit">
                {en["demo.start.habit"]}
              </p>
              <p id="demo-repeat" class="t-secondary" data-i18n="demo.start.repeat">
                {en["demo.start.repeat"]}
              </p>
            </div>
            <div id="demo-second" class="demo-habit" hidden>
              <p class="t-row" data-i18n="demo.move.secondHabit">
                {en["demo.move.secondHabit"]}
              </p>
              <p id="demo-second-repeat" class="t-secondary" data-i18n="demo.move.secondRepeat">
                {en["demo.move.secondRepeat"]}
              </p>
            </div>
          </div>
          <form id="demo-edit-form" class="demo-edit-form" hidden>
            <label for="demo-edit-name" data-i18n="demo.name">{en["demo.name"]}</label>
            <input id="demo-edit-name" type="text" maxlength="80" required />
            <label for="demo-edit-schedule" data-i18n="demo.schedule">{en["demo.schedule"]}</label>
            <select id="demo-edit-schedule">
              <option value="morning" data-i18n="demo.start.repeat"
                >{en["demo.start.repeat"]}</option
              >
              <option value="afternoon" data-i18n="demo.afternoon">{en["demo.afternoon"]}</option>
              <option value="evening" data-i18n="demo.start.alternateRepeat"
                >{en["demo.start.alternateRepeat"]}</option
              >
            </select>
            <button type="submit" class="demo-save" data-i18n="demo.save">{en["demo.save"]}</button>
          </form>
          <div class="demo-preview-actions">
            <PillButton id="demo-reject" variant="ghost" size="sm"
              ><span data-i18n="demo.reject">{en["demo.reject"]}</span></PillButton
            >
            <PillButton id="demo-edit" variant="ghost" size="sm"
              ><span data-i18n="demo.edit">{en["demo.edit"]}</span></PillButton
            >
            <PillButton id="demo-approve" variant="primary" size="sm"
              ><span data-i18n="demo.approve">{en["demo.approve"]}</span></PillButton
            >
          </div>
        </div>
        <p id="demo-result" class="t-body" hidden></p>
        <p id="demo-announcement" class="sr-only"></p>
      </div>
    </div>
    <div id="demo-today" class="demo-today" hidden>
      <p class="product-caption"><Copy name="product.approved" /></p>
      <h3><Copy name="product.today" /></h3>
      <button type="button" class="habit-row" data-habit-toggle aria-pressed="false">
        <span class="habit-emoji" aria-hidden="true">🚶</span><span class="habit-copy">
          <span id="demo-today-habit" class="habit-name"></span><span
            id="demo-today-repeat"
            class="product-caption"
          >
          </span>
        </span><span class="habit-check" aria-hidden="true"
          ><span class="status-ring"><Check size={16} /></span></span
        >
      </button>
      <button
        type="button"
        id="demo-today-second"
        class="habit-row"
        data-habit-toggle
        aria-pressed="false"
        hidden
      >
        <span class="habit-emoji" aria-hidden="true">📖</span><span class="habit-copy">
          <span class="habit-name" data-i18n="demo.move.secondHabit">
            {en["demo.move.secondHabit"]}
          </span><span id="demo-today-second-repeat" class="product-caption"></span>
        </span><span class="habit-check" aria-hidden="true"
          ><span class="status-ring"><Check size={16} /></span></span
        >
      </button>
    </div>
    <div id="demo-continue" class="demo-continue" hidden>
      <p data-i18n="demo.continue">{en["demo.continue"]}</p>
      <a
        id="demo-continue-link"
        class="text-link"
        href={appUrl}
        data-app-url={appUrl}
        data-i18n="demo.continueAction">{en["demo.continueAction"]}</a
      >
    </div>
  </div>
  <div class="demo-input-area">
    <div
      class="demo-examples"
      role="group"
      aria-label={en["demo.choose"]}
      data-i18n-label="demo.choose"
    >
      {
        (["start", "restart", "move"] as const).map((example, index) => (
          <button
            type="button"
            class="demo-chip"
            data-demo={example}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span data-i18n={`demo.${example}.chip`}>{en[`demo.${example}.chip`]}</span>
          </button>
        ))
      }
    </div>
    <form class="demo-composer" id="demo-composer">
      <input
        id="demo-input"
        type="text"
        maxlength="120"
        required
        autocomplete="off"
        aria-label={en["demo.inputLabel"]}
        data-i18n-label="demo.inputLabel"
        placeholder={en["demo.composer"]}
        data-i18n-placeholder="demo.composer"
      />
      <button
        type="submit"
        class="demo-send"
        aria-label={en["demo.send"]}
        data-i18n-label="demo.send"><ArrowUp size={16} /></button
      >
    </form>
  </div>
</section>
