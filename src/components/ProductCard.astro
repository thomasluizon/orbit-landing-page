---
import { Bell, Check } from "@lucide/astro";
import AstraGlyph from "./AstraGlyph.astro";
import Copy from "./Copy.astro";
import HabitRow from "./HabitRow.astro";
import { landingCopy, translations } from "../i18n/translations";
interface Props {
  kind: "today" | "week" | "reminder" | "insight";
}
const { kind } = Astro.props;
import { exampleWeek, exampleDays } from "../config/product-examples";
import type { LandingKey } from "../i18n/translations";
function dayLabel(index: number, language: "en" | "pt-BR") {
  return (
    landingCopy[language][`blocks.metrics.date${index}` as LandingKey] +
    ", " +
    landingCopy[language]["blocks.metrics.done"]
      .replace("{done}", String(exampleDays[index].done))
      .replace("{total}", String(exampleDays[index].total))
  );
}
---

<div class:list={["product-card", `product-${kind}`]} data-mock="true" data-product-kind={kind}>
  {
    kind === "today" && (
      <>
        <div class="today-pager">
          <>
            <h3>
              <Copy name="product.today" />
            </h3>
          </>
        </div>
        <div class="proactive-line">
          <>
            <AstraGlyph />
            <p>
              <Copy name="product.proactive" />
            </p>
          </>
        </div>
        <HabitRow habit="walk" timing="morning" />
        <HabitRow habit="water" timing="done" />
        <button
          type="button"
          class="habit-row"
          data-demo-approved
          data-habit-toggle
          aria-pressed="false"
          hidden
        >
          <span class="habit-copy">
            <>
              <span class="habit-name" data-approved-name />
              <span class="product-caption" data-approved-repeat />
            </>
          </span>
          <span class="habit-check" aria-hidden="true">
            <span class="status-ring">
              <Check size={16} />
            </span>
          </span>
        </button>
        <button
          type="button"
          class="habit-row"
          data-demo-approved-second
          data-habit-toggle
          aria-pressed="false"
          hidden
        >
          <span class="habit-copy">
            <>
              <span class="habit-name" data-i18n="demo.move.secondHabit">
                {translations.en["demo.move.secondHabit"]}
              </span>
              <span class="product-caption" data-approved-second-repeat />
            </>
          </span>
          <span class="habit-check" aria-hidden="true">
            <span class="status-ring">
              <Check size={16} />
            </span>
          </span>
        </button>
      </>
    )
  }
  {
    kind === "week" && (
      <>
        <div class="product-top">
          <>
            <h3>
              <Copy name="product.week" />
            </h3>
          </>
        </div>
        <div
          class="week-chart"
          aria-description={landingCopy.en["product.chart"]}
          data-week-chart
          role="group"
          aria-label={landingCopy.en["blocks.metrics.choose"]}
          data-copy-label-en={landingCopy.en["blocks.metrics.choose"]}
          data-copy-label-pt={landingCopy["pt-BR"]["blocks.metrics.choose"]}
        >
          {exampleWeek.map((height, index) => (
            <button
              type="button"
              class="chart-column"
              data-week-day={index}
              aria-pressed={index === 6}
              aria-label={dayLabel(index, "en")}
              data-copy-label-en={dayLabel(index, "en")}
              data-copy-label-pt={dayLabel(index, "pt-BR")}
            >
              <span class="chart-track">
                <span class="chart-bar" style={`--bar-height: ${height}%`} />
              </span>
              <span class="chart-day" aria-hidden="true">
                {index + 12}
              </span>
            </button>
          ))}
        </div>
        <div class="product-caption week-readout" aria-live="polite">
          {exampleDays.map((_, index) => (
            <span
              data-week-readout={index}
              hidden={index !== 6}
              data-copy-en={dayLabel(index, "en")}
              data-copy-pt={dayLabel(index, "pt-BR")}
            >
              {dayLabel(index, "en")}
            </span>
          ))}
        </div>
      </>
    )
  }
  {
    kind === "reminder" && (
      <>
        <div class="product-top">
          <>
            <span class="product-icon">
              <Bell size={20} />
            </span>
            <span class="product-caption">
              <Copy name="product.reminder" />
            </span>
          </>
        </div>
        <h3>
          <Copy name="product.ready" />
        </h3>
      </>
    )
  }
  {
    kind === "insight" && (
      <>
        <div class="product-top">
          <AstraGlyph />
          <span translate="no">Astra</span>
        </div>
        <p>
          <Copy name="product.insight" />
        </p>
      </>
    )
  }
</div>
