---
import { Bell } from "@lucide/astro";
import AstraGlyph from "./AstraGlyph.astro";
import Copy from "./Copy.astro";
import { landingCopy } from "../i18n/translations";
interface Props {
  kind: "week" | "reminder" | "insight";
}
const { kind } = Astro.props;
import { buildNow } from "../config/product-examples";
import { demoCopy } from "../i18n/demo-copy";
import { dayKey } from "../scripts/demo-dates";
import { weekHtml } from "../scripts/week";
const copy = kind === "week" ? demoCopy() : undefined;
const week = copy ? weekHtml(buildNow, dayKey(buildNow), "en", copy) : undefined;
---

<div
  class:list={["product-card", `product-${kind}`]}
  data-mock="true"
  data-product-kind={kind}
  data-week-card={kind === "week" || undefined}
  data-demo-copy={copy && JSON.stringify(copy)}
>
  {
    kind === "week" && (
      <>
        <div class="product-top">
          <>
            <h3>
              <Copy name="product.week" />
            </h3>
          </>
        </div>
        <div
          class="week-days"
          data-week-days
          role="group"
          aria-label={landingCopy.en["blocks.metrics.choose"]}
          data-copy-label-en={landingCopy.en["blocks.metrics.choose"]}
          data-copy-label-pt={landingCopy["pt-BR"]["blocks.metrics.choose"]}
          set:html={week?.days}
        />
        <div
          class="product-caption week-readout"
          aria-live="polite"
          data-week-readouts
          set:html={week?.readouts}
        />
      </>
    )
  }
  {
    kind === "reminder" && (
      <>
        <div class="product-top">
          <>
            <span class="product-icon">
              <Bell size={20} />
            </span>
            <span class="product-caption">
              <Copy name="product.reminder" />
            </span>
          </>
        </div>
        <h3>
          <Copy name="product.ready" />
        </h3>
      </>
    )
  }
  {
    kind === "insight" && (
      <>
        <div class="product-top">
          <AstraGlyph />
        </div>
        <p>
          <Copy name="product.insight" />
        </p>
      </>
    )
  }
</div>
