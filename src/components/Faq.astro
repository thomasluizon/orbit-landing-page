---
import { translations } from "../i18n/translations";
const en = translations.en;
const items = [1, 2, 3, 4, 5, 6, 7] as const;
---

<section id="faq" class="section page-container faq-section" aria-labelledby="faq-title">
  <h2 id="faq-title" class="t-display" data-i18n="faq.title">{en["faq.title"]}</h2>
  <div class="faq-list">
    {
      items.map((n) => (
        <details name="questions">
          <>
            <summary>
              <>
                <span data-i18n={`faq.q${n}`}>{en[`faq.q${n}`]}</span>
                <span class="faq-indicator" aria-hidden="true">
                  +
                </span>
              </>
            </summary>
            <p class="t-body text-fg-2" data-i18n={`faq.a${n}`}>
              {en[`faq.a${n}`]}
            </p>
          </>
        </details>
      ))
    }
  </div>
</section>
