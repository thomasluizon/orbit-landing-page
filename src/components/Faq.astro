---
import { ChevronDown } from "@lucide/astro";
import Copy from "./Copy.astro";
import AstraBlock from "./AstraBlock.astro";
import { translations } from "../i18n/translations";
const questions = ["what", "approval", "miss", "plans", "platforms"] as const;
---

<section id="faq" class="section" data-section="faq" aria-labelledby="faq-title">
  <div class="section-inner">
    <div class="section-heading">
      <h2 id="faq-title" class="section-title"><Copy name="faq.title" /></h2>
    </div>
    <div class="faq-list">
      {
        questions.map((key) => (
          <details name="orbit-questions">
            <>
              <summary aria-expanded="false" aria-controls={`faq-answer-${key}`}>
                <>
                  <Copy name={`faq.${key}.q`} />
                  <ChevronDown size={16} aria-hidden="true" focusable="false" />
                </>
              </summary>
              <p id={`faq-answer-${key}`}>
                <Copy name={`faq.${key}.a`} />
                {key === "platforms" && (
                  <a
                    href="#ios"
                    data-ios-trigger
                    class="text-link"
                    aria-haspopup="dialog"
                    aria-controls="ios"
                    data-i18n="hero.ios"
                  >
                    {translations.en["hero.ios"]}
                  </a>
                )}
              </p>
              {key === "approval" && (
                <div class="faq-example">
                  <AstraBlock kind="breakdown" interactive />
                  <p class="composition-caption">
                    <Copy name="product.example" />
                  </p>
                </div>
              )}
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>
