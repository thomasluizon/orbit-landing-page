---
import PillButton from "./PillButton.astro";
import { translations } from "../i18n/translations";
import { pricesFor } from "../config/pricing";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
const en = translations.en;
const prices = pricesFor("en");
---

<section id="pricing" class="section page-container" aria-labelledby="pricing-title">
  <p class="t-eyebrow" data-i18n="pricing.eyebrow">{en["pricing.eyebrow"]}</p>
  <h2 id="pricing-title" class="t-display section-title" data-i18n="pricing.title">
    {en["pricing.title"]}
  </h2>
  <div class="pricing-grid">
    {
      (["free", "pro"] as const).map((plan) => (
        <article class:list={["plan", { "plan-pro": plan === "pro" }]}>
          <h3 class="t-h2" data-i18n={`pricing.${plan}.name`}>
            {en[`pricing.${plan}.name`]}
          </h3>
          <p class="plan-allowance" data-i18n={`pricing.${plan}.allowance`}>
            {en[`pricing.${plan}.allowance`]}
          </p>
          <div class="plan-prices">
            {plan === "free" ? (
              <p class="t-num" data-i18n="pricing.free.price">
                {prices.free} / month
              </p>
            ) : (
              <>
                <p class="t-num" data-i18n="pricing.pro.monthly">
                  {en["pricing.pro.monthly"]}
                </p>
                <p class="t-secondary" data-i18n="pricing.pro.yearly">
                  {en["pricing.pro.yearly"]}
                </p>
                <p class="t-secondary" data-i18n="pricing.pro.savings">
                  {en["pricing.pro.savings"]}
                </p>
              </>
            )}
          </div>
          <ul class="plan-outcomes">
            {([1, 2, 3] as const).map((n) => (
              <li data-i18n={`pricing.${plan}.f${n}`}>{en[`pricing.${plan}.f${n}`]}</li>
            ))}
          </ul>
          <PillButton
            href={appUrl}
            variant={plan === "pro" ? "primary" : "ghost"}
            size="sm"
            analyticsEvent={`pricing_${plan}_cta_clicked`}
            analyticsSurface={`pricing_${plan}`}
          >
            <span data-i18n="pricing.cta">{en["pricing.cta"]}</span>
          </PillButton>
        </article>
      ))
    }
  </div>
  <p class="t-body pricing-trial" data-i18n="pricing.trial">{en["pricing.trial"]}</p>
  <p class="t-secondary" data-i18n="pricing.note">{en["pricing.note"]}</p>
</section>
