---
import { Check } from "@lucide/astro";
import SentenceTitle from "./SentenceTitle.astro";
import Copy from "./Copy.astro";
import PillButton from "./PillButton.astro";
import { formatPrice } from "../config/pricing";
import { landingCopy } from "../i18n/translations";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
---

<section id="pricing" class="section" data-section="pricing" aria-labelledby="pricing-title">
  <div class="section-inner">
    <div class="section-heading">
      <SentenceTitle id="pricing-title" name="pricing.title" /><p class="section-description">
        <Copy name="pricing.body" />
      </p>
    </div>
    <div
      class="billing-control"
      role="radiogroup"
      aria-label={landingCopy.en["nav.pricing"]}
      data-copy-label-en={landingCopy.en["nav.pricing"]}
      data-copy-label-pt={landingCopy["pt-BR"]["nav.pricing"]}
      data-billing-control
    >
      <button
        class="billing-option"
        type="button"
        role="radio"
        data-billing-period="monthly"
        aria-checked="true"
        tabindex="0"><Copy name="pricing.monthly" /></button
      >
      <button
        class="billing-option"
        type="button"
        role="radio"
        data-billing-period="yearly"
        aria-checked="false"
        tabindex="-1"><Copy name="pricing.annual" /></button
      >
    </div>
    <div class="pricing-grid">
      <article class="plan-card">
        <div class="plan-name"><h3 translate="no">Free</h3></div>
        <p class="plan-description"><Copy name="pricing.free.body" /></p>
        <p class="plan-price">
          <span class="price-value" data-price="free">{formatPrice("en", "free")}</span>
        </p>
        <p class="plan-annual"><Copy name="trust.free" /></p>
        <ul>
          {
            (["pricing.free.astra", "pricing.habits", "pricing.review"] as const).map((name) => (
              <li>
                <>
                  <Check size={16} />
                  <Copy name={name} />
                </>
              </li>
            ))
          }
        </ul>
        <div class="plan-action">
          <PillButton href={appUrl} variant="ghost"><Copy name="action.start" /></PillButton>
        </div>
      </article>
      <article class="plan-card plan-pro">
        <div class="plan-name">
          <h3 translate="no">Pro</h3><span class="plan-badge"
            ><Copy name="pricing.recommended" /></span
          >
        </div>
        <p class="plan-description"><Copy name="pricing.pro.body" /></p>
        <p class="plan-price" aria-live="polite" aria-atomic="true">
          <span class="price-value" data-price="monthly" data-pro-price
            >{formatPrice("en", "monthly")}</span
          ><span
            class="plan-period"
            data-plan-period
            data-month-en={landingCopy.en["pricing.month"]}
            data-month-pt={landingCopy["pt-BR"]["pricing.month"]}
            data-year-en={landingCopy.en["pricing.year"]}
            data-year-pt={landingCopy["pt-BR"]["pricing.year"]}><Copy name="pricing.month" /></span
          >
        </p>
        <p
          class="plan-annual"
          data-annual-equivalent
          data-template-en={landingCopy.en["pricing.equivalent"]}
          data-template-pt={landingCopy["pt-BR"]["pricing.equivalent"]}
          hidden
        >
          {
            landingCopy.en["pricing.equivalent"].replace(
              "{price}",
              formatPrice("en", "monthlyEquivalent"),
            )
          }
        </p>
        <ul>
          {
            (["pricing.pro.astra", "pricing.pro.adjust", "pricing.pro.calendar"] as const).map(
              (name) => (
                <li>
                  <>
                    <Check size={16} />
                    <Copy name={name} />
                  </>
                </li>
              ),
            )
          }
        </ul>
        <div class="plan-action">
          <PillButton href={`${appUrl}/upgrade`}><Copy name="pricing.pro.cta" /></PillButton>
        </div>
      </article>
    </div>
  </div>
</section>
