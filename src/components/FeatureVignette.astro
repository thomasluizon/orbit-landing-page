---
import AstraBlock from "./AstraBlock.astro";
import ProductCard from "./ProductCard.astro";
import Copy from "./Copy.astro";
interface Props {
  kind: "start" | "remember" | "act" | "restart";
}
const { kind } = Astro.props;
---

<div class="feature-vignette" aria-hidden="true" data-mock="true">
  {kind === "start" && <AstraBlock kind="breakdown" embedded />}
  {kind === "remember" && <ProductCard kind="reminder" />}
  {kind === "act" && <AstraBlock kind="habits" embedded />}
  {kind === "restart" && <AstraBlock kind="metrics" embedded />}
  <p class="composition-caption"><Copy name="product.example" /></p>
</div>
