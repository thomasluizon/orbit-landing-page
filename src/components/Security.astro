---
import OrbitProduct from "./OrbitProduct.astro";
import Copy from "./Copy.astro";
const promises = [
  { key: "approval", kind: "widget" },
  { key: "edit", kind: "offline" },
  { key: "control", kind: "devices" },
  { key: "privacy", kind: "privacy" },
] as const;
---

<section class="section" data-section="security" aria-labelledby="security-title">
  <div class="section-inner">
    <div class="section-heading">
      <h2 id="security-title" class="section-title"><Copy name="security.title" /></h2><p
        class="section-description"
      >
        <Copy name="security.body" />
      </p>
    </div>
    <div class="security-grid">
      {
        promises.map(({ key, kind }) => (
          <article class="promise-card" data-reveal>
            <>
              <div class="orbit-vignette" aria-hidden="true">
                <OrbitProduct kind={kind} />
              </div>
              <div class="promise-copy">
                <h3>
                  <Copy name={`security.${key}.title`} />
                </h3>
                <p>
                  <Copy name={`security.${key}.body`} />
                </p>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
