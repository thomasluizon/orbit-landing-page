---
import PillButton from "./PillButton.astro";
import { translations } from "../i18n/translations";
interface Props {
  googlePlayUrl: string;
}
const { googlePlayUrl } = Astro.props;
const en = translations.en;
---

<section class="section page-container final-cta">
  <h2 class="t-display">
    <span data-i18n="cta.title1">{en["cta.title1"]}</span><span data-i18n="cta.title2"
      >{en["cta.title2"]}</span>
  </h2>
  <p class="t-body text-fg-2" data-i18n="cta.subtitle">{en["cta.subtitle"]}</p>
  <PillButton
    href={googlePlayUrl}
    external
    analyticsEvent="final_cta_clicked"
    analyticsSurface="footer"><span data-i18n="cta.button">{en["cta.button"]}</span></PillButton
  >
</section>
