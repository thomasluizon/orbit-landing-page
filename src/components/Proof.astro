---
import { translations } from "../i18n/translations";
const en = translations.en;
---

<figure id="proof" class="founder">
  <p class="t-eyebrow" data-i18n="proof.eyebrow">{en["proof.eyebrow"]}</p>
  <h2 class="t-secondary" data-i18n="proof.title">{en["proof.title"]}</h2>
  <blockquote class="t-body" data-i18n="proof.founder.body">
    {en["proof.founder.body"]}
  </blockquote>
  <figcaption class="t-meta" data-i18n="proof.founder.name">{en["proof.founder.name"]}</figcaption>
</figure>
