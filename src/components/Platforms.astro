---
import PillButton from "./PillButton.astro";
import { translations } from "../i18n/translations";
interface Props {
  appUrl: string;
  googlePlayUrl: string;
}
const { appUrl, googlePlayUrl } = Astro.props;
const en = translations.en;
---

<section id="platforms" class="section page-container" aria-labelledby="platforms-title">
  <h2 id="platforms-title" class="t-display" data-i18n="platforms.title">
    {en["platforms.title"]}
  </h2>
  <div class="platform-grid">
    {
      (["android", "web"] as const).map((platform) => (
        <article>
          <>
            <h3 class="t-h2" data-i18n={`platforms.${platform}.title`}>
              {en[`platforms.${platform}.title`]}
            </h3>
            <p class="t-body text-fg-2" data-i18n={`platforms.${platform}.desc`}>
              {en[`platforms.${platform}.desc`]}
            </p>
            <PillButton
              href={platform === "android" ? googlePlayUrl : appUrl}
              variant="ghost"
              size="sm"
              external={platform === "android"}
              analyticsEvent={`platforms_${platform === "android" ? "google_play" : platform}_cta_clicked`}
              analyticsSurface={`platforms_${platform}`}
            >
              <span data-i18n={`platforms.${platform}.cta`}>{en[`platforms.${platform}.cta`]}</span>
            </PillButton>
          </>
        </article>
      ))
    }
  </div>
</section>
