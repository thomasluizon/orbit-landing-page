---
import FeatureVignette from "./FeatureVignette.astro";
import Copy from "./Copy.astro";
import PillButton from "./PillButton.astro";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
const features = ["start", "remember", "act", "restart"] as const;
---

<section id="features" class="section" data-section="features" aria-labelledby="features-title">
  <div class="section-inner">
    <div class="section-heading">
      <h2 id="features-title" class="section-title"><Copy name="features.title" /></h2>
      <p class="section-description"><Copy name="features.body" /></p>
    </div>
    <div class="feature-grid">
      {
        features.map((key) => (
          <article class="feature-card">
            <FeatureVignette kind={key} />
            <div class="feature-card-copy">
              <h3>
                <Copy name={`features.${key}.title`} />
              </h3>
              <p>
                <Copy name={`features.${key}.body`} />
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <PillButton
      href={appUrl}
      variant="primary"
      size="md"
      class="feature-grid-action"
      analyticsEvent="hero_app_cta_clicked"
      analyticsSurface="features"><Copy name="action.start" /></PillButton
    >
  </div>
</section>
