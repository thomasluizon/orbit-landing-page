---
import OutlineIcon from "./OutlineIcon.astro";
import Copy from "./Copy.astro";
const features = [
  { key: "start", icon: "message-circle" },
  { key: "remember", icon: "bell" },
  { key: "act", icon: "list-check" },
  { key: "restart", icon: "restore" },
] as const;
---

<section id="features" class="section" data-section="features" aria-labelledby="features-title">
  <div class="section-inner">
    <div class="section-heading">
      <h2 id="features-title" class="section-title"><Copy name="features.title" /></h2>
      <p class="section-description"><Copy name="features.body" /></p>
    </div>
    <div class="feature-grid">
      {
        features.map(({ key, icon }) => (
          <article class="feature-card">
            <OutlineIcon name={icon} />
            <div class="feature-card-copy">
              <h3>
                <Copy name={`features.${key}.title`} />
              </h3>
              <p>
                <Copy name={`features.${key}.body`} />
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
