---
import { translations } from "../i18n/translations";
const en = translations.en;
const features = ["tracker", "goals", "progress", "widget"] as const;
---

<section id="features" class="section page-container" aria-labelledby="features-title">
  <h2 id="features-title" class="t-display section-title">
    <span data-i18n="features.title1">{en["features.title1"]}</span><span
      data-i18n="features.title2">{en["features.title2"]}</span
    >
  </h2>
  <div class="feature-grid">
    {
      features.map((feature) => (
        <article>
          <>
            <h3 class="t-h2" data-i18n={`features.${feature}.title`}>
              {en[`features.${feature}.title`]}
            </h3>
            <p class="t-body text-fg-2" data-i18n={`features.${feature}.desc`}>
              {en[`features.${feature}.desc`]}
            </p>
          </>
        </article>
      ))
    }
  </div>
</section>
