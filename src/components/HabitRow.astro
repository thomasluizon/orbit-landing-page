---
import { Check } from "@lucide/astro";
import Copy from "./Copy.astro";
import { landingCopy } from "../i18n/translations";
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  habit: "walk" | "water" | "run" | "stretch" | "read";
  timing?: "morning" | "done" | "todo";
  time?: string;
  days?: number;
  static?: boolean;
}
const {
  habit,
  timing = "morning",
  time,
  days,
  static: isStatic = false,
  ...attributes
} = Astro.props;
const Tag = isStatic ? "div" : "button";
const control = isStatic
  ? {}
  : { type: "button" as const, "data-habit-toggle": true, "aria-pressed": timing === "done" };
const emoji = { walk: "🚶", water: "💧", run: "🏃", stretch: "🧘", read: "📖" };
---

<Tag {...attributes} {...control} class="habit-row">
  <span class="habit-emoji" aria-hidden="true">{emoji[habit]}</span>
  <span class="habit-copy">
    <span class="habit-name"><slot name="name"><Copy name={`product.${habit}`} /></slot></span>
    <span class="product-caption">
      <slot name="repeat">
        {
          days !== undefined ? (
            <span
              data-copy-en={landingCopy.en["blocks.goal.days"].replace("{days}", String(days))}
              data-copy-pt={landingCopy["pt-BR"]["blocks.goal.days"].replace(
                "{days}",
                String(days),
              )}
            >
              {landingCopy.en["blocks.goal.days"].replace("{days}", String(days))}
            </span>
          ) : time ? (
            <time>{time}</time>
          ) : (
            <Copy name={`product.${timing}`} />
          )
        }
      </slot>
    </span>
  </span>
  <span class="habit-check" aria-hidden="true"
    ><span class:list={["status-ring", { "is-done": timing === "done" }]}><Check size={16} /></span
    ></span
  >
</Tag>
