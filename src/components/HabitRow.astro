---
import { Check } from "@lucide/astro";
import Copy from "./Copy.astro";
import { landingCopy } from "../i18n/translations";
interface Props {
  habit: "walk" | "read" | "water";
  timing?: "morning" | "evening" | "done";
  interactive?: boolean;
}
const { habit, timing = "evening", interactive = false } = Astro.props;
const emoji = { walk: "🚶", read: "📖", water: "💧" };
---

<div class="habit-row">
  <span class="habit-emoji" aria-hidden="true">{emoji[habit]}</span>
  <div>
    <p class="habit-name"><Copy name={`product.${habit}`} /></p>
    <p class="product-caption"><Copy name={`product.${timing}`} /></p>
  </div>
  {
    interactive ? (
      <button
        class="log-control"
        type="button"
        data-example-log
        data-habit={habit}
        data-log-en={landingCopy.en["blocks.habits.log"].replace(
          "{habit}",
          landingCopy.en[`product.${habit}`],
        )}
        data-log-pt={landingCopy["pt-BR"]["blocks.habits.log"].replace(
          "{habit}",
          landingCopy["pt-BR"][`product.${habit}`],
        )}
        data-undo-en={landingCopy.en["blocks.habits.undo"].replace(
          "{habit}",
          landingCopy.en[`product.${habit}`],
        )}
        data-undo-pt={landingCopy["pt-BR"]["blocks.habits.undo"].replace(
          "{habit}",
          landingCopy["pt-BR"][`product.${habit}`],
        )}
        aria-pressed="false"
        aria-label={landingCopy.en["blocks.habits.log"].replace(
          "{habit}",
          landingCopy.en[`product.${habit}`],
        )}
      >
        <span class="status-ring" aria-hidden="true">
          <Check size={16} />
        </span>
      </button>
    ) : (
      <span class:list={["status-ring", { "is-done": timing === "done" }]} aria-hidden="true">
        {timing === "done" && <Check size={16} />}
      </span>
    )
  }
</div>
