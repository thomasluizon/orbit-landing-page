---
import AstraDemo from "./AstraDemo.astro";
import PillButton from "./PillButton.astro";
import ProductCard from "./ProductCard.astro";
import Copy from "./Copy.astro";
import { translations } from "../i18n/translations";
import { Signal, Wifi, BatteryFull } from "@lucide/astro";
interface Props {
  googlePlayUrl: string;
  appUrl: string;
}
const { googlePlayUrl, appUrl } = Astro.props;
const en = translations.en;
---

<section id="hero" class="hero" data-section="hero">
  <div class="hero-copy">
    <h1 class="t-hero" data-i18n="hero.title">{en["hero.title"]}</h1>
    <p class="hero-description" data-i18n="hero.subtitle">{en["hero.subtitle"]}</p>
  </div>
  <div class="hero-controls">
    <div class="hero-actions">
      <PillButton
        href={googlePlayUrl}
        size="md"
        external
        analyticsEvent="hero_google_play_cta_clicked"
        analyticsSurface="hero"><span data-i18n="hero.cta">{en["hero.cta"]}</span></PillButton
      >
    </div>
  </div>
  <div class="hero-pin-range">
    <div class="hero-stage" id="hero-stage">
      <div class="hero-float float-today" data-hero-float data-hero-side="left">
        <ProductCard kind="today" />
      </div>
      <div class="hero-phone">
        <div class="hero-device">
          <div class="device-screen">
            <div class="device-status" aria-hidden="true">
              <span data-mock>9:41</span>
              <span class="device-speaker"></span>
              <span class="device-status-icons"
                ><Signal size={16} /><Wifi size={16} /><BatteryFull size={20} /></span
              >
            </div>
            <AstraDemo appUrl={appUrl} />
            <div class="device-home" aria-hidden="true"></div>
          </div>
        </div>
        <p class="composition-caption"><Copy name="product.example" /></p>
      </div>
      <div class="hero-right">
        <div class="hero-float float-week" data-hero-float data-hero-side="right">
          <ProductCard kind="week" />
        </div>
        <div class="hero-float float-reminder" data-hero-float data-hero-side="right">
          <ProductCard kind="reminder" />
        </div>
      </div>
      <p class="hero-phrase phrase-start" data-hero-float data-hero-side="left">
        <Copy name="phrase.start" />
      </p>
      <p class="hero-phrase phrase-restart" data-hero-float data-hero-side="right">
        <Copy name="phrase.restart" />
      </p>
    </div>
  </div>
</section>
