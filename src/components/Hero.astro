---
import AstraDemo from "./AstraDemo.astro";
import PillButton from "./PillButton.astro";
import ProductCard from "./ProductCard.astro";
import TrustStrip from "./TrustStrip.astro";
import Copy from "./Copy.astro";
import { translations } from "../i18n/translations";
import { Signal, Wifi, BatteryFull, Pause, Play } from "@lucide/astro";
interface Props {
  googlePlayUrl: string;
  appUrl: string;
}
const { googlePlayUrl, appUrl } = Astro.props;
const en = translations.en;
---

<section id="hero" class="hero" data-section="hero">
  <div class="hero-copy">
    <h1 class="t-hero" data-i18n="hero.title">{en["hero.title"]}</h1>
    <p class="hero-description" translate="no" data-i18n="hero.subtitle">{en["hero.subtitle"]}</p>
  </div>
  <div class="hero-controls">
    <div class="hero-actions">
      <PillButton
        href={googlePlayUrl}
        size="md"
        external
        analyticsEvent="hero_google_play_cta_clicked"
        analyticsSurface="hero"
        ><span translate="no" data-i18n="hero.cta">{en["hero.cta"]}</span></PillButton
      >
    </div>
  </div>
  <div class="hero-pin-range">
    <div class="hero-stage" id="hero-stage">
      <div class="hero-phone">
        <div class="hero-device">
          <div class="device-screen">
            <div class="device-status" aria-hidden="true">
              <span data-mock>9:41</span>
              <span class="device-speaker"></span>
              <span class="device-status-icons"
                ><Signal size={16} /><Wifi size={16} /><BatteryFull size={20} /></span
              >
            </div>
            <div class="phone-carousel" data-phone-carousel data-lenis-prevent>
              <div class="phone-slide" id="phone-chat" data-phone-slide="chat">
                <AstraDemo appUrl={appUrl} />
              </div>
              <div class="phone-slide" id="phone-today" data-phone-slide="today" data-mobile-screen>
                <ProductCard kind="today" />
              </div>
              <div class="phone-slide" id="phone-week" data-phone-slide="week" data-mobile-screen>
                <ProductCard kind="week" />
              </div>
              <div
                class="phone-slide"
                id="phone-reminder"
                data-phone-slide="reminder"
                data-mobile-screen
              >
                <ProductCard kind="insight" /><ProductCard kind="reminder" />
              </div>
            </div>
            <div class="device-home" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <div class="hero-motion-controls">
        <div
          class="carousel-segments"
          role="group"
          aria-label={en["carousel.label"]}
          data-i18n-label="carousel.label"
        >
          {
            (["chat", "today", "week", "reminder"] as const).map((screen, index) => (
              <button
                type="button"
                class="carousel-segment"
                data-carousel-segment={index}
                aria-controls={`phone-${screen}`}
                aria-current={index === 0 ? "true" : "false"}
                aria-label={en[`carousel.${screen}`]}
                data-i18n-label={`carousel.${screen}`}
              >
                <span class="carousel-progress">
                  <span class="carousel-progress-fill" />
                </span>
              </button>
            ))
          }
        </div>
        <button
          type="button"
          id="hero-playback"
          class="hero-playback"
          aria-label={en["demo.pause"]}
          data-i18n-label="demo.pause"
          aria-pressed="false"
          ><Pause size={16} class="hero-pause-icon" /><Play
            size={16}
            class="hero-play-icon"
          /></button
        >
      </div>
      <div class="hero-products">
        <div class="hero-side hero-left" data-hero-column>
          <p class="hero-phrase phrase-start" data-hero-float>
            <Copy name="phrase.start" />
          </p>
          <div class="hero-float float-reminder" data-hero-float>
            <ProductCard kind="reminder" />
          </div>
          <div class="hero-float float-today" data-hero-float>
            <ProductCard kind="today" />
          </div>
        </div>
        <div class="hero-side hero-right" data-hero-column>
          <div class="hero-float float-insight" data-hero-float>
            <ProductCard kind="insight" />
          </div>
          <p class="hero-phrase phrase-restart" data-hero-float>
            <Copy name="phrase.restart" />
          </p>
          <div class="hero-float float-week" data-hero-float>
            <ProductCard kind="week" />
          </div>
        </div>
      </div>
    </div>
  </div>
  <TrustStrip />
</section>

<script>
  import "../scripts/hero-carousel";
</script>
