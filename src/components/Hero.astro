---
import PillButton from "./PillButton.astro";
import PhoneHeader from "./PhoneHeader.astro";
import PhoneStatus from "./PhoneStatus.astro";
import HabitRow from "./HabitRow.astro";
import AiBlock from "./AiBlock.astro";
import OrbitProduct from "./OrbitProduct.astro";
import OrbitMascot from "./OrbitMascot.astro";
import TrustStrip from "./TrustStrip.astro";
import DownloadsPanel from "./DownloadsPanel.astro";
import PlatformMark from "./PlatformMark.astro";
import Copy from "./Copy.astro";
import { translations } from "../i18n/translations";
import { appStoreUrl } from "../config/app-store";
import { buildNow } from "../config/product-examples";
import { clockText } from "../scripts/clock-format";
import { ArrowUp, ChevronLeft, ChevronRight, ChevronDown } from "@lucide/astro";
interface Props {
  appUrl: string;
  googlePlayUrl: string;
}
const { appUrl, googlePlayUrl } = Astro.props;
const en = translations.en;
const todayDate = clockText("today", buildNow);
---

<section id="hero" class="hero" data-section="hero">
  <div class="hero-copy">
    <OrbitMascot size={128} class="hero-orbit" />
    <h1 class="t-hero" data-i18n="hero.title">{en["hero.title"]}</h1>
    <p class="hero-description" translate="no" data-i18n="hero.subtitle">{en["hero.subtitle"]}</p>
  </div>
  <div class="hero-controls">
    <div class="hero-actions">
      <PillButton
        href={appUrl}
        appEntry
        size="md"
        analyticsEvent="hero_app_cta_clicked"
        analyticsSurface="hero"
        ><span translate="no" data-i18n="hero.cta">{en["hero.cta"]}</span></PillButton
      >
      <PillButton href="#downloads" variant="ghost" size="md" id="hero-download">
        <span data-hero-download-label="any"><Copy name="download.label" /></span>
        <span data-hero-download-label="mac" hidden
          ><PlatformMark platform="apple" /><Copy name="hero.download.mac" /></span
        >
        <span data-hero-download-label="mac-unreported" hidden
          ><PlatformMark platform="apple" /><Copy name="hero.download.macUnreported" /></span
        >
        <span data-hero-download-label="windows" hidden
          ><PlatformMark platform="windows" /><Copy name="hero.download.windows" /></span
        >
        <span data-hero-download-label="android" hidden><Copy name="footer.android" /></span>
        {
          appStoreUrl ? (
            <span data-hero-download-label="iphone" hidden>
              <Copy name="download.appStore" />
            </span>
          ) : (
            <span data-hero-download-label="iphone" hidden data-i18n="hero.ios">
              {en["hero.ios"]}
            </span>
          )
        }
      </PillButton>
    </div>
    <div id="downloads" class="downloads-disclosure">
      <button
        type="button"
        id="downloads-toggle"
        class="text-link downloads-toggle"
        aria-expanded="false"
        aria-controls="downloads-panel"
        data-analytics-event="download_list_opened"
        data-analytics-surface="hero_all_downloads"
      >
        <Copy name="hero.downloads" /><span class="downloads-chevron" aria-hidden="true"
          ><ChevronDown size={16} /></span
        >
      </button>
      <DownloadsPanel googlePlayUrl={googlePlayUrl} appStoreUrl={appStoreUrl} />
    </div>
  </div>
  <div class="hero-pin-range">
    <div class="hero-stage" id="hero-stage">
      <div class="hero-fan" aria-hidden="true" inert>
        <div class="hero-phone hero-phone-left">
          <div class="hero-device">
            <div class="device-screen phone-light">
              <div class="phone-screen">
                <PhoneStatus />
                <div class="phone-body">
                  <div class="phone-slide">
                    <PhoneHeader>
                      <div class="phone-today-pager">
                        <span class="phone-day-chevron"><ChevronLeft size={20} /></span>
                        <div class="phone-today-date">
                          <p class="phone-heading"><Copy name="product.today" /></p>
                          <p class="product-caption">
                            <span
                              data-clock="today"
                              data-copy-en={todayDate.en}
                              data-copy-pt={todayDate["pt-BR"]}>{todayDate.en}</span
                            >
                          </p>
                        </div>
                        <span class="phone-day-chevron"><ChevronRight size={20} /></span>
                      </div>
                    </PhoneHeader>
                    <div class="phone-content phone-today-content">
                      <div class="proactive-line phone-today-orbit">
                        <OrbitMascot size={16} />
                        <p><Copy name="today.ai" /></p>
                      </div>
                      <div class="phone-today-habits">
                        <HabitRow static habit="water" timing="done" time="08:00" />
                        <HabitRow static habit="stretch" timing="done" />
                        <HabitRow static habit="walk" timing="todo" time="18:00" />
                        <HabitRow static habit="read" timing="todo" />
                        <HabitRow static habit="run" days={7} />
                      </div>
                    </div>
                  </div>
                </div>
                <div class="device-home"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-phone hero-phone-center">
          <div class="hero-device">
            <div class="device-screen phone-light">
              <div class="phone-screen">
                <PhoneStatus />
                <div class="phone-body">
                  <div class="phone-slide">
                    <PhoneHeader>
                      <OrbitMascot size={16} />
                      <p class="phone-heading" translate="no">Orbit</p>
                    </PhoneHeader>
                    <div class="phone-content hero-chat">
                      <p class="demo-request t-body">
                        <span class="demo-request-text"><Copy name="hero.week.request" /></span>
                      </p>
                      <AiBlock kind="metrics" />
                    </div>
                    <div class="demo-input-area">
                      <div class="demo-composer hero-composer">
                        <span class="demo-composer-field">
                          <span class="hero-composer-text" data-i18n="demo.composer"
                            >{en["demo.composer"]}</span
                          >
                        </span>
                        <span class="demo-send"><ArrowUp size={20} /></span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="device-home"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-phone hero-phone-right">
          <div class="hero-device">
            <div class="device-screen phone-light">
              <div class="phone-screen">
                <PhoneStatus />
                <div class="phone-body">
                  <div class="phone-slide">
                    <PhoneHeader>
                      <p class="phone-heading"><Copy name="product.calendar" /></p>
                    </PhoneHeader>
                    <div class="phone-content hero-calendar">
                      <OrbitProduct kind="calendar" static />
                    </div>
                  </div>
                </div>
                <div class="device-home"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <TrustStrip />
</section>

<script>
  import "../scripts/phone-screen";
  import "../scripts/desktop-downloads";
</script>
