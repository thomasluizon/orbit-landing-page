---
import { landingCopy, type LandingKey } from "../i18n/translations";
interface Props {
  id: string;
  name: LandingKey;
}
const { id, name } = Astro.props;
const split = (text: string) => text.split(/(?<=[.!?])\s+/u);
const en = split(landingCopy.en[name]);
const pt = split(landingCopy["pt-BR"][name]);
---

<h2
  id={id}
  class="section-title sentence-title"
  aria-label={landingCopy.en[name]}
  data-copy-label-en={landingCopy.en[name]}
  data-copy-label-pt={landingCopy["pt-BR"][name]}
>
  {
    en.map((sentence, index) => (
      <>
        <span
          class="heading-sentence"
          data-copy-en={sentence}
          data-copy-pt={pt[index]}
          aria-hidden="true"
        >
          {sentence}
        </span>{" "}
      </>
    ))
  }
</h2>
