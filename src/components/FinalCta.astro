---
import Copy from "./Copy.astro";
import CookiePreferences from "./CookiePreferences.astro";
import PillButton from "./PillButton.astro";
import orbitLockup from "../../public/brand/orbit-lockup.svg?raw";
interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
---

<section class="final-section" data-section="final" aria-labelledby="final-title">
  <div class="section-inner">
    <div class="closing-copy">
      <div class="section-heading">
        <h2 id="final-title" class="section-title"><Copy name="final.title" accent="Astra" /></h2>
        <p class="section-description"><Copy name="final.body" /></p>
      </div>
      <PillButton
        href={appUrl}
        appEntry
        size="sm"
        analyticsEvent="hero_app_cta_clicked"
        analyticsSurface="footer"><Copy name="final.cta" /></PillButton
      >
    </div>
    <footer class="product-footer">
      <div class="footer-columns">
        <div class="footer-brand">
          <a href="#hero" class="brand brand-lockup" aria-label="Orbit" set:html={orbitLockup} />
          <p><Copy name="footer.description" /></p>
        </div>
        <nav
          class="footer-column"
          aria-label="Product"
          data-copy-label-en="Product"
          data-copy-label-pt="Produto"
        >
          <h3><Copy name="footer.product" /></h3>
          <a href={appUrl} data-app-entry class="text-link" data-i18n="header.cta">Open Orbit</a>
        </nav>
        <div class="footer-column">
          <h3><Copy name="footer.legal" /></h3>
          <a href={`${appUrl}/privacy`} class="text-link" data-i18n="footer.privacy"
            >Privacy policy</a
          >
          <a href={`${appUrl}/terms`} class="text-link" data-i18n="footer.terms">Terms</a>
          <CookiePreferences />
        </div>
      </div>
      <div class="closing-legal">
        <p><Copy name="footer.controller" /></p>
        <p>
          <a class="text-link" href="mailto:contact@useorbit.org"><Copy name="footer.requests" /></a
          >
        </p>
        <span translate="no">© Orbit</span>
      </div>
    </footer>
  </div>
</section>
