---
import {
  Check,
  ChevronRight,
  ListChecks,
  Snowflake,
  WifiOff,
  Monitor,
  Smartphone,
  Download,
  Trash2,
  RefreshCw,
} from "@lucide/astro";
import Copy from "./Copy.astro";
import { exampleMonth } from "../config/product-examples";
import { landingCopy } from "../i18n/translations";
interface Props {
  kind: "steps" | "calendar" | "agenda" | "progress" | "widget" | "offline" | "devices" | "privacy";
}
const { kind } = Astro.props;
const cells = Array.from({ length: 42 }, (_, index) => index - 4);
---

<div class:list={["product-block", "orbit-product", `orbit-${kind}`]} data-mock="true">
  {
    kind === "steps" && (
      <>
        <div class="orbit-list-row">
          <ListChecks size={20} aria-hidden="true" />
          <div class="orbit-row-copy">
            <h3>
              <Copy name="orbit.routine" />
            </h3>
            <span class="product-caption">
              <Copy name="orbit.checklist" /> · 1/2
            </span>
          </div>
          <span class="status-ring" aria-hidden="true" />
        </div>
        <div class="orbit-child-row">
          <>
            <Check size={16} aria-hidden="true" />
            <Copy name="product.water" />
          </>
        </div>
        <div class="orbit-child-row">
          <>
            <span class="orbit-check" aria-hidden="true" />
            <Copy name="product.stretch" />
          </>
        </div>
        <div class="orbit-list-row">
          <div class="orbit-row-copy">
            <p class="habit-name">
              <Copy name="product.walk" />
            </p>
            <span class="product-caption">
              <Copy name="orbit.overdue" />
            </span>
          </div>
          <span class="status-ring orbit-overdue-ring" aria-hidden="true" />
        </div>
        <div class="orbit-list-row">
          <div class="orbit-row-copy">
            <p class="habit-name">
              <Copy name="orbit.avoid" />
            </p>
            <span class="product-caption">
              <Copy name="orbit.bad" />
            </span>
          </div>
          <span class="orbit-bad-mark" aria-hidden="true">
            −
          </span>
        </div>
      </>
    )
  }
  {
    kind === "calendar" && (
      <>
        <h3>
          <Copy name="orbit.calendar" />
        </h3>
        <p class="orbit-month-title">
          <Copy name="orbit.august" />
        </p>
        <div class="orbit-view-labels" aria-hidden="true">
          <span data-current>
            <Copy name="orbit.month" />
          </span>
          <span>
            <Copy name="orbit.week" />
          </span>
          <span>
            <Copy name="orbit.agenda" />
          </span>
        </div>
        <div class="orbit-month-grid" aria-hidden="true">
          {landingCopy.en["product.days"].split(" ").map((day, index) => (
            <span
              class="product-caption"
              data-copy-en={day}
              data-copy-pt={landingCopy["pt-BR"]["product.days"].split(" ")[index]}
            >
              {day}
            </span>
          ))}
          {cells.map((day) => (
            <span class="orbit-date" data-current={day === 18 || undefined}>
              {day > 0 && day <= 31 ? day : ""}
              {day > 0 && day < 18 && (
                <span class:list={["orbit-date-dot", { "is-done": day % 4 !== 0 }]} />
              )}
            </span>
          ))}
        </div>
      </>
    )
  }
  {
    kind === "agenda" && (
      <>
        <h3>
          <Copy name="orbit.agenda" />
        </h3>
        <div class="orbit-list-row">
          <span class="product-caption">07:00</span>
          <p class="habit-name">
            <Copy name="product.walk" />
          </p>
          <span class="status-ring" aria-hidden="true" />
        </div>
        <div class="orbit-list-row">
          <span class="product-caption">14:00</span>
          <div class="orbit-row-copy">
            <p class="habit-name">
              <Copy name="orbit.appointment" />
            </p>
            <p class="product-caption">
              <Copy name="orbit.google" />
            </p>
          </div>
        </div>
      </>
    )
  }
  {
    kind === "progress" && (
      <>
        <h3>
          <Copy name="orbit.progress" />
        </h3>
        <div class="orbit-streak">
          <span class="orbit-streak-number">12</span>
          <span>
            <Copy name="orbit.streak" />
          </span>
        </div>
        <div class="orbit-streak-strip" aria-hidden="true">
          {Array.from({ length: 14 }, (_, index) => (
            <span data-frozen={index === 5 || undefined} data-missed={index < 2 || undefined}>
              {index === 5 ? <Snowflake size={16} /> : index < 2 ? "−" : <Check size={16} />}
            </span>
          ))}
        </div>
        <div class="orbit-list-row">
          <Snowflake size={20} aria-hidden="true" />
          <div class="orbit-row-copy">
            <p>
              <Copy name="orbit.freezes" /> · 2
            </p>
            <p class="product-caption">
              <Copy name="orbit.repair" />
            </p>
          </div>
        </div>
        <p class="product-caption">
          <Copy name="orbit.monthChart" />
        </p>
        <div
          class="orbit-month-chart"
          role="img"
          aria-label={landingCopy.en["orbit.monthChartLabel"]}
          data-copy-label-en={landingCopy.en["orbit.monthChartLabel"]}
          data-copy-label-pt={landingCopy["pt-BR"]["orbit.monthChartLabel"]}
        >
          {exampleMonth.map((value) => (
            <span style={`--bar-height: ${value}%`} />
          ))}
        </div>
      </>
    )
  }
  {
    kind === "widget" && (
      <>
        <div class="product-top">
          <>
            <span translate="no">Orbit</span>
            <RefreshCw size={16} aria-hidden="true" />
          </>
        </div>
        <h3>
          <Copy name="product.today" />
        </h3>
        {(["walk", "read"] as const).map((habit, index) => (
          <div class="orbit-list-row">
            <span class:list={["status-ring", { "is-done": index === 0 }]} aria-hidden="true">
              {index === 0 && <Check size={16} />}
            </span>
            <p class="habit-name">
              <Copy name={`product.${habit}`} />
            </p>
          </div>
        ))}
      </>
    )
  }
  {
    kind === "offline" && (
      <>
        <div class="orbit-list-row">
          <>
            <WifiOff size={20} aria-hidden="true" />
            <h3>
              <Copy name="orbit.offline" />
            </h3>
          </>
        </div>
        <div class="orbit-list-row">
          <>
            <span class="status-ring is-done" aria-hidden="true">
              <Check size={16} />
            </span>
            <Copy name="product.water" />
          </>
        </div>
        <p class="product-caption">
          <Copy name="orbit.pending" />
        </p>
      </>
    )
  }
  {
    kind === "devices" && (
      <>
        <h3>
          <Copy name="orbit.account" />
        </h3>
        <div class="orbit-device-pair">
          {(["android", "web"] as const).map((platform) => (
            <div class="orbit-device-panel">
              {platform === "web" ? (
                <Monitor size={24} aria-hidden="true" />
              ) : (
                <Smartphone size={24} aria-hidden="true" />
              )}
              <p>
                <Copy name={`orbit.${platform}`} />
              </p>
              <span class="status-ring is-done" aria-hidden="true">
                <Check size={16} />
              </span>
              <span class="product-caption">
                <Copy name="product.read" />
              </span>
            </div>
          ))}
        </div>
      </>
    )
  }
  {
    kind === "privacy" && (
      <>
        <div class="orbit-list-row">
          <>
            <Download size={20} aria-hidden="true" />
            <span>
              <Copy name="orbit.export" />
            </span>
            <ChevronRight size={16} aria-hidden="true" />
          </>
        </div>
        <div class="orbit-list-row">
          <>
            <Trash2 size={20} aria-hidden="true" />
            <span>
              <Copy name="orbit.delete" />
            </span>
            <ChevronRight size={16} aria-hidden="true" />
          </>
        </div>
      </>
    )
  }
</div>
