---
import { Check, ChevronLeft, ChevronRight, Snowflake, Trophy } from "@lucide/astro";
import Copy from "./Copy.astro";
import { buildNow } from "../config/product-examples";
import { demoCopy } from "../i18n/demo-copy";
import { landingCopy } from "../i18n/translations";
import { calendarView } from "../scripts/calendar-view";
import { addMonths, dayKey } from "../scripts/demo-dates";
interface Props {
  kind: "calendar" | "progress" | "achievements";
}
const { kind } = Astro.props;
const copy = kind === "calendar" ? demoCopy() : undefined;
const calendar = copy
  ? calendarView(addMonths(buildNow, 0), dayKey(buildNow), buildNow, "en", copy)
  : undefined;
const monthLabel = (name: "calendar.previousMonth" | "calendar.nextMonth") => ({
  "aria-label": landingCopy.en[name],
  "data-copy-label-en": landingCopy.en[name],
  "data-copy-label-pt": landingCopy["pt-BR"][name],
});
---

<div class:list={["orbit-composition", `orbit-${kind}`]} data-mock="true" data-product-kind={kind}>
  {
    calendar && (
      <div
        class="product-block orbit-product"
        data-composition-card
        data-calendar
        data-clock-pending
        data-demo-copy={JSON.stringify(copy)}
      >
        <div class="calendar-month-nav">
          <button
            type="button"
            class="calendar-nav-button"
            data-calendar-previous
            {...monthLabel("calendar.previousMonth")}
          >
            <ChevronLeft size={20} aria-hidden="true" />
          </button>
          <button
            type="button"
            class="calendar-month-title"
            data-calendar-title
            aria-disabled={calendar.isToday ? "true" : "false"}
            aria-label={calendar.labels.title.en}
            data-copy-label-en={calendar.labels.title.en}
            data-copy-label-pt={calendar.labels.title["pt-BR"]}
            set:html={calendar.title}
          />
          <button
            type="button"
            class="calendar-nav-button"
            data-calendar-next
            {...monthLabel("calendar.nextMonth")}
          >
            <ChevronRight size={20} aria-hidden="true" />
          </button>
        </div>
        <div
          class="orbit-month-grid"
          role="group"
          data-calendar-grid
          aria-label={calendar.labels.group.en}
          data-copy-label-en={calendar.labels.group.en}
          data-copy-label-pt={calendar.labels.group["pt-BR"]}
          set:html={calendar.grid}
        />
        <section class="calendar-day-card" data-calendar-panel>
          <h3
            data-calendar-day-title
            aria-live="polite"
            data-copy-en={calendar.dayTitle.en}
            data-copy-pt={calendar.dayTitle["pt-BR"]}
          >
            {calendar.dayTitle.en}
          </h3>
          <p
            class="calendar-day-summary"
            data-calendar-summary
            data-copy-en={calendar.summary.en}
            data-copy-pt={calendar.summary["pt-BR"]}
          >
            {calendar.summary.en}
          </p>
          <div
            class="calendar-day-events"
            data-calendar-events
            data-composition-secondary
            set:html={calendar.events}
          />
        </section>
      </div>
    )
  }
  {
    kind === "progress" && (
      <div class="product-block orbit-product" data-composition-card>
        <h3>
          <Copy name="orbit.progress" />
        </h3>
        <div class="orbit-streak">
          <span class="orbit-streak-number">12</span>
          <Copy name="orbit.streak" />
        </div>
        <div class="orbit-list-row">
          <Snowflake size={24} aria-hidden="true" />
          <div class="orbit-row-copy">
            <h3>
              <Copy name="orbit.freezes" /> · 2
            </h3>
            <p class="product-caption">
              <Copy name="orbit.repair" />
            </p>
          </div>
        </div>
      </div>
    )
  }
  {
    kind === "achievements" && (
      <div class="product-block" data-composition-card>
        <div class="orbit-list-row">
          <>
            <Trophy size={24} aria-hidden="true" />
            <h3>
              <Copy name="orbit.achievements" />
            </h3>
          </>
        </div>
        {(["orbit.firstWeek", "orbit.firstHabit"] as const).map((name) => (
          <div class="orbit-list-row">
            <span class="status-ring is-done" aria-hidden="true">
              <Check size={16} />
            </span>
            <div>
              <p>
                <Copy name={name} />
              </p>
              <p class="product-caption">
                <Copy name="orbit.earned" />
              </p>
            </div>
          </div>
        ))}
        <p class="product-caption">
          <Copy name="orbit.wrapped" />
        </p>
      </div>
    )
  }
</div>
