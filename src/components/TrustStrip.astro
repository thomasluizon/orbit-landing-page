---
import Copy from "./Copy.astro";
import { translations } from "../i18n/translations";
---

<section class="trust-strip" data-section="trust">
  <dl class="trust-content">
    <div class="trust-fact">
      <dt><Copy name="trust.free.title" /></dt>
      <dd><Copy name="trust.free.caption" /></dd>
    </div>
    <div class="trust-fact">
      <dt><Copy name="trust.approval.title" /></dt>
      <dd><Copy name="trust.approval.caption" /></dd>
    </div>
    <div class="trust-fact">
      <dt data-i18n="hero.platforms">{translations.en["hero.platforms"]}</dt>
      <dd><Copy name="trust.platforms.caption" /></dd>
    </div>
  </dl>
</section>
